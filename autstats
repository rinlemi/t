if not game:IsLoaded() then game.Loaded:Wait() end
local Players = game:GetService("Players")
while not Players.LocalPlayer do task.wait() end
local VIM = game:GetService("VirtualInputManager")
local GS  = game:GetService("GuiService")
local pg  = Players.LocalPlayer:WaitForChild("PlayerGui")

-- ===== CẤU HÌNH =====
local MAX_STAT    = 84     -- sửa thành 86... khi game nâng trần
local START_DELAY = 0      -- chờ đã làm ở file autoexec
local DELAY       = 0.6
local DEBUG       = true   -- test xong đổi thành false

-- {tên frame trên UI, ID gửi server}
local ORDER = {
    {"Chackra",  "Chackra"},
    {"Genjutsu", "Genjutsu"},
    {"Ninjutsu", "Ninjutsu"},
    {"Taijutsu", "Taijutsu"},
}

_G.STOP_STAT = false
local function log(...) if DEBUG then print("[stats]", ...) end end

-- chờ remote xuất hiện (map không có thì chỉ đứng chờ, không báo lỗi)
local Event
repeat
    local ok, r = pcall(function()
        return game:GetService("ReplicatedStorage").Modules.Services.RNet.Bridges.AttributesRemote_Function
    end)
    if ok then Event = r else task.wait(1) end
until Event

local function getFrame(name)
    local i = pg:FindFirstChild("Interface")
    local a = i and i:FindFirstChild("Attributes")
    local b = a and a:FindFirstChild("Attributes")
    return b and b:FindFirstChild(name)
end

local function readStat(frame)
    local nt = frame:FindFirstChild("NameText")
    local v  = nt and nt:FindFirstChild("Value")
    if v and v:IsA("TextLabel") then
        return tonumber(v.Text:match("(%d+)%s*/%s*%d+"))
    end
end

local function getYes()
    local i  = pg:FindFirstChild("Interface")
    local yn = i and i:FindFirstChild("YesOrNo")
    local op = yn and yn:FindFirstChild("Options")
    local y  = op and op:FindFirstChild("Yes")
    if not y then return nil end
    local p = y
    while p and p ~= pg do
        if p:IsA("GuiObject") and not p.Visible then return nil end
        if p:IsA("ScreenGui") and not p.Enabled then return nil end
        p = p.Parent
    end
    if y.AbsoluteSize.X <= 0 then return nil end
    return y
end

local function click(btn)
    GS.SelectedObject = btn
    task.wait(0.1)
    VIM:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
    task.wait(0.05)
    VIM:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
    task.wait(0.2)
    GS.SelectedObject = nil
    if getYes() then
        local pos = btn.AbsolutePosition + btn.AbsoluteSize / 2
        local y = pos.Y + GS:GetGuiInset().Y
        VIM:SendMouseButtonEvent(pos.X, y, 0, true, game, 0)
        task.wait(0.05)
        VIM:SendMouseButtonEvent(pos.X, y, 0, false, game, 0)
    end
end

local function bump(id, frame, before)
    task.spawn(function()
        pcall(function() Event:InvokeServer({ID = id, Job = "IncreaseLevel"}) end)
    end)
    local t, yes = os.clock(), nil
    repeat
        yes = getYes()
        if not yes then task.wait(0.1) end
    until yes or os.clock() - t > 5
    if not yes then return false end
    task.wait(0.2 + math.random() * 0.2)
    pcall(click, yes)
    t = os.clock()
    repeat
        task.wait(0.15)
        local now = readStat(frame)
        if now and now > before then return true end
    until os.clock() - t > 3
    return false
end

-- ===== MAIN =====
task.spawn(function()
    log("da khoi dong")
    if START_DELAY > 0 then task.wait(START_DELAY) end

    for _, pair in ipairs(ORDER) do
        local name, id = pair[1], pair[2]
        if _G.STOP_STAT then return end

        local frame
        repeat
            frame = getFrame(name)
            if not frame then task.wait(1) end
        until frame or _G.STOP_STAT
        if not frame then return end

        local fails = 0
        while true do
            if _G.STOP_STAT then return end
            local cur = readStat(frame)
            if not cur then log("khong doc duoc so:", name) return end
            log(name, cur .. "/" .. MAX_STAT)
            if cur >= MAX_STAT then break end   -- đủ rồi, sang chỉ số kế

            if bump(id, frame, cur) then
                fails = 0
            else
                fails += 1
                if fails >= 3 then
                    log("dung tai", name, "- nang khong tang")
                    return   -- hết điểm / lỗi: dừng hẳn, không nâng lung tung
                end
            end
            task.wait(DELAY + math.random() * 0.3)
        end
    end
    log("xong tat ca")
end)
