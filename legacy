local function P(root, ...)
    for _, n in ipairs({...}) do
        if not root then return nil end
        root = root:FindFirstChild(n)
    end
    return root
end

local function shown(g)
    local o = g
    while o and o ~= pg do
        if o:IsA("GuiObject") and not o.Visible then return false end
        if o:IsA("ScreenGui") and not o.Enabled then return false end
        o = o.Parent
    end
    return true
end

local function click(obj)
    if not obj then return false end
    local btn = obj:IsA("GuiButton") and obj or obj:FindFirstChildWhichIsA("GuiButton", true)
    if btn then
        for _, ev in ipairs({"MouseButton1Click", "Activated"}) do
            if getconnections then
                for _, c in ipairs(getconnections(btn[ev])) do
                    pcall(function() c:Fire() end)
                end
            end
        end
        if firesignal then
            for _, ev in ipairs({"MouseButton1Click", "Activated"}) do
                pcall(function() firesignal(btn[ev]) end)
            end
        end
        pcall(function() btn:Activate() end)
    end
    local t = btn or obj
    if t and t.AbsoluteSize and t.AbsoluteSize.X > 0 then
        local pos = t.AbsolutePosition + t.AbsoluteSize / 2 + GuiService:GetGuiInset()
        VIM:SendMouseMoveEvent(pos.X, pos.Y, game)
        task.wait(0.05)
        VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
        task.wait(0.05)
        VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
    end
    return true
end

local function rnd(a, b) return a + math.random() * (b - a) end

local function smoothStop(lv, root, duration)
    if not (lv and lv.Parent and root and root.Parent) then
        if lv and lv.Parent then lv.VectorVelocity = Vector3.zero end
        return
    end
    local v0  = lv.VectorVelocity
    local mag = v0.Magnitude
    if mag < 5 then
        lv.VectorVelocity = Vector3.zero
        return
    end
    duration = duration or STOP_TIME_FINISH
    local dir = v0.Unit
    local t0  = os.clock()
    while os.clock() - t0 < duration do
        if not lv.Parent or not root.Parent then return end
        local a = 1 - (os.clock() - t0) / duration
        a = math.clamp(a, 0, 1) * math.clamp(a, 0, 1)
        lv.VectorVelocity = dir * (mag * a)
        RS.Heartbeat:Wait()
    end
    if lv.Parent then lv.VectorVelocity = Vector3.zero end
end

