local lastLapSpeed
local function pickLapSpeed()
    local c = {}
    for v = RAND_MIN, RAND_MAX, RAND_STEP do
        if not lastLapSpeed or math.abs(v - lastLapSpeed) >= RAND_MIN_DIFF then
            c[#c + 1] = v
        end
    end
    if #c == 0 then return RAND_MIN end
    lastLapSpeed = c[math.random(#c)]
    return lastLapSpeed
end

