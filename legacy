end

local function spawnCar()
    if not isVehicleMenuOpen() then
        status("Mo menu xe...")
        local menuVehicle = P(pg, "MainUI", "MainFrame", "Menu", "Vehicle")
        if menuVehicle then
            click(menuVehicle)
            local t = os.clock()
            while os.clock() - t < 5 do
                if isVehicleMenuOpen() then break end
                task.wait(0.25)
            end
            task.wait(0.5)
        else
            print("   ⚠️ Không tìm thấy Menu.Vehicle")
            return nil
        end
    end

    if VEHICLE_NAME ~= "" then
        local list = P(pg, "MainUI", "MainFrame", "Selected", "Vehicle", "ListPane", "VehicleList")
        if list then
            local veh = list:FindFirstChild(VEHICLE_NAME)
            if veh then
                print("   🚗 Chọn xe:", VEHICLE_NAME)
                click(veh)
                task.wait(0.8)
            end
        end
    end

    status("Click Spawn...")
    task.wait(0.3)

    local spawnBtn = P(pg, "MainUI", "MainFrame", "Selected", "Vehicle", "Hero", "Acts", "Spawn")
    if not spawnBtn then
        local selV = P(pg, "MainUI", "MainFrame", "Selected", "Vehicle")
        if selV then
            for _, v in ipairs(selV:GetDescendants()) do
                if v:IsA("GuiButton") and v.Visible and v.AbsoluteSize.X > 20 then
                    local n = v.Name:lower()
                    local t = (v:IsA("TextButton") and v.Text or ""):lower()
                    if n:find("spawn") or t:find("spawn") then
                        spawnBtn = v
                        break
                    end
                end
            end
        end
    end

    if not spawnBtn then
        print("   ❌ Không tìm thấy nút Spawn")
        return nil
    end

    click(spawnBtn)
    status("Cho xe spawn...")
    task.wait(2)

    return waitFor(function()
        local c, s = findCar()
        if c then
            print("   ✅ Xe đã spawn:", c:GetFullName())
            return {c, s}
        end
    end, 20)
end

local function sit(seat)
    local ch  = lp.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not (hum and hrp) then return false end

    local car = seat:FindFirstAncestorOfClass("Model")
    local prompt
    if car then
        for _, v in ipairs(car:GetDescendants()) do
            if v:IsA("ProximityPrompt") and v.Enabled then
                prompt = v
                break
            end
        end
    end
    if not prompt then
        prompt = seat:FindFirstChildWhichIsA("ProximityPrompt", true)
    end

    if not prompt then
        print("   ⚠️ Không có ProximityPrompt → fallback sit")
        pcall(function() seat:Sit(hum) end)
        task.wait(1.5)
        return hum.SeatPart ~= nil
    end

    local holdDur = prompt.HoldDuration or 0
    print(string.format("   🪑 Prompt: %s | Hold: %.2fs", prompt:GetFullName(), holdDur))

    for attempt = 1, 6 do
        if hum.SeatPart then
            print("   ✅ Đã ngồi (SeatPart = " .. hum.SeatPart.Name .. ")")
            return true
        end

        local carCF = car and car:GetPivot() or seat.CFrame
        local sideOffset = carCF:VectorToWorldSpace(Vector3.new(4, 0, 0))
        local standPos = CFrame.new(seat.Position + sideOffset + Vector3.new(0, 2, 0))

        hrp.CFrame = standPos
        hum:ChangeState(Enum.HumanoidStateType.Running)
        task.wait(0.6)

        if fireproximityprompt then
            pcall(function() fireproximityprompt(prompt) end)
            task.wait(math.max(holdDur, 0.3) + 0.5)
        end

        if not hum.SeatPart then
            VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(math.max(holdDur, 0.5) + 0.3)
            VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            task.wait(0.5)
        end

        print(string.format("   🔄 Lần %d | Seated: %s", attempt, tostring(hum.SeatPart ~= nil)))
    end

    return hum.SeatPart ~= nil
end

local function setupRaceConstraints(root)
    for _, n in ipairs({"RaceAttachment", "RaceLinearVelocity", "RaceAlignOrientation"}) do
        local old = root:FindFirstChild(n)
        if old then old:Destroy() end
    end

    local att = Instance.new("Attachment")
    att.Name = "RaceAttachment"
    att.Parent = root

    local lv = Instance.new("LinearVelocity")
    lv.Name = "RaceLinearVelocity"
    lv.Attachment0 = att
    lv.MaxForce = MAX_FORCE
    lv.VectorVelocity = Vector3.zero
    lv.RelativeTo = Enum.ActuatorRelativeTo.World
    pcall(function()
        lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
        lv.MaxAxesForce = Y_FORCE_FULL
            and Vector3.new(MAX_FORCE, MAX_FORCE, MAX_FORCE)
            or  Vector3.new(MAX_FORCE, 0, MAX_FORCE)
    end)
    lv.Parent = root

    local ao = Instance.new("AlignOrientation")
    ao.Name = "RaceAlignOrientation"
    ao.Attachment0 = att
    ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
    ao.MaxTorque = MAX_FORCE
    ao.Responsiveness = math.clamp(AO_RESPONSIVE, 1, 200)
    ao.RigidityEnabled = false
    ao.Parent = root

    return lv, ao, att
end

local function cleanupRace(lv, ao, att)
    if lv  then pcall(function() lv:Destroy()  end) end
    if ao  then pcall(function() ao:Destroy()  end) end
    if att then pcall(function() att:Destroy() end) end
end

-- ===== CHẠY 1 VÒNG =====
local function runLap(car, seat)
    local root = seat.AssemblyRootPart or seat
    local hum  = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    if not (car and car.Parent and seat.Parent and root) then return false end

    local d0, dist0 = nearestD(root.Position)
    if dist0 > MAX_PATH_DIST then
        print(string.format("   ❌ Xe cách path %.0f stud (> %d) → không chạy", dist0, MAX_PATH_DIST))
        return false, "far_from_path"
    end
    print(string.format("   📍 Bắt đầu từ d=%.0f/%.0f, lệch %.1f stud", d0, TOTAL, dist0))

    local d, t0 = d0, os.clock()
    local look = (at(math.min(d0 + LOOKAHEAD, TOTAL)) - at(d0))
    look = look.Magnitude > 0.01 and look.Unit or root.CFrame.LookVector
    local cur, jit, jitYaw, nextJ, miss = 0, 0, 0, 0, 0
    local maxT = (TOTAL - d0) / math.max(SPEED - 5, 20) * 1.6 + 15

    local releaseDist = math.max(RELEASE_MIN_DIST, SPEED * RELEASE_TIME_AHEAD)
    local released, releaseT0, releaseV0, releaseDur = false, 0, 0, 0

    local function poseDir(dir)
        return CFrame.lookAt(Vector3.zero, dir * CAR_FORWARD_SIGN)
            * CFrame.Angles(0, math.rad(YAW), 0)
    end

    local lv, ao, att = setupRaceConstraints(root)

    lv.VectorVelocity = Vector3.zero
    ao.CFrame = poseDir(look)
    task.wait(WARMUP_TIME)

    if root.Parent then
        d = select(1, projectD(root.Position, d0))
    end

    while running do
        local dt  = RS.Heartbeat:Wait()
        local now = os.clock()

        if not car.Parent or not seat.Parent or not root.Parent then
            cleanupRace(lv, ao, att)
            return false
        end
        if now - t0 > maxT then
            smoothStop(lv, root, STOP_TIME_STOP)
            task.wait(0.25)
            cleanupRace(lv, ao, att)
            return false
        end
        if hum and not hum.SeatPart then
            miss += 1
            if miss > 30 then
                cleanupRace(lv, ao, att)
                return false
            end
        else
            miss = 0
        end

        if now >= nextJ then
            jit    = math.random(JITTER_MIN, JITTER_MAX)
            jitYaw = (math.random() - 0.5) * 2 * YAW_NOISE
            nextJ  = now + rnd(0.3, 0.9)
        end

        cur = cur + (SPEED + jit - cur) * math.clamp(dt / ACCEL_TAU, 0, 1)

        local realPos = root.Position
        local realD, distToPath = projectD(realPos, d)

        if released then
            if realD > d then d = math.min(realD, TOTAL) end

            local elapsed = now - releaseT0
            if elapsed >= releaseDur then
                if lv.Parent then lv.VectorVelocity = Vector3.zero end
                task.wait(0.2)
                cleanupRace(lv, ao, att)
                return true
            end

            local a = 1 - elapsed / releaseDur
            a = math.clamp(a, 0, 1) * math.clamp(a, 0, 1)
            local dv
            if d < TOTAL then
                local p = at(d)
                local dd = at(math.min(d + LOOKAHEAD, TOTAL)) - p
                dv = dd.Magnitude > 0.01 and dd.Unit or look
            else
                dv = look
            end
            local targetV
            if Y_FORCE_FULL then
                targetV = dv * (releaseV0 * a)
            else
                local flat = Vector3.new(dv.X, 0, dv.Z)
                targetV = flat.Magnitude > 0.01 and flat.Unit * (releaseV0 * a) or Vector3.zero
            end
            lv.VectorVelocity = targetV

            local l = look:Lerp(dv, math.clamp(LOOK_LERP_RATE * dt, 0, 1))
            if l.Magnitude > 0.01 then look = l.Unit end
            ao.CFrame = poseDir(look)

            lbProg.Text  = string.format("Tien do: %d%% (phanh)", math.min(100, math.floor(d / TOTAL * 100)))
            lbTime.Text  = string.format("Thoi gian: %.1fs", now - t0)
            lbSpeed.Text = string.format("Phanh cuoi: %.0f -> 0", releaseV0 * a)
        else
            if distToPath <= MAX_PATH_DIST then
                d = math.min(realD + cur * dt, TOTAL)
            else
                d = math.min(d + cur * dt * 0.5, TOTAL)
            end

            if d >= TOTAL - releaseDist then
                released   = true
                releaseT0  = now
                releaseV0  = math.max(cur, lv.VectorVelocity.Magnitude)
                local want = (TOTAL - d) + FINISH_OVERSHOOT
                releaseDur = math.clamp(3 * want / math.max(releaseV0, 30), FINISH_DUR_MIN, FINISH_DUR_MAX)
                print(string.format("   🏁 Phanh cuối: v0=%.0f, còn %.0f stud, dur=%.2fs",
                    releaseV0, TOTAL - d, releaseDur))
            else
                local pos = at(d)
                local dir = at(d + LOOKAHEAD) - pos
                local dv
                if dir.Magnitude > 0.01 then
                    dv = dir.Unit
                else
                    dv = look
                end
                if Y_FORCE_FULL then
                    lv.VectorVelocity = dv * cur
                else
                    local flat = Vector3.new(dv.X, 0, dv.Z)
                    if flat.Magnitude > 0.01 then
                        lv.VectorVelocity = flat.Unit * cur
                    end
                end
                local l = look:Lerp(dv, math.clamp(LOOK_LERP_RATE * dt, 0, 1))
                if l.Magnitude > 0.01 then look = l.Unit end
                ao.CFrame = poseDir(look) * CFrame.Angles(0, math.rad(jitYaw), 0)

                lbProg.Text  = string.format("Tien do: %d%%", d / TOTAL * 100)
                lbTime.Text  = string.format("Thoi gian: %.1fs", now - t0)
                lbSpeed.Text = string.format("Toc do: %d | Lech: %.1f", math.floor(cur + 0.5), distToPath)
            end
        end
    end

    if not released then
        smoothStop(lv, root, STOP_TIME_STOP)
        task.wait(0.25)
    end
    cleanupRace(lv, ao, att)
    return false
end

