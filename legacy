local running = false

local function findCar()
    local vf = workspace:FindFirstChild("Vehicles")
    if not vf then return nil end
    local f = vf:FindFirstChild(lp.Name)
    if not f then
        for _, c in ipairs(vf:GetChildren()) do
            if c.Name:lower():find(lp.Name:lower()) then f = c; break end
        end
    end
    if not f then return nil end
    local m = f:FindFirstChildOfClass("Model")
    if not m then
        for _, c in ipairs(f:GetChildren()) do
            if c:IsA("Model") then m = c; break end
        end
    end
    if not m then return nil end
    local s = m:FindFirstChild("DriveSeat", true)
        or m:FindFirstChildWhichIsA("VehicleSeat", true)
        or m:FindFirstChildWhichIsA("Seat", true)
    if s then return m, s end
end

local function isSeatedIn(car)
    local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    local sp = hum and hum.SeatPart
    return sp ~= nil and car ~= nil and sp:IsDescendantOf(car)
end

local function waitFor(fn, timeout)
    local t = os.clock()
    while running and os.clock() - t < timeout do
        local r = fn()
        if r then return r end
        task.wait(0.25)
    end
end

local function isVehicleMenuOpen()
    local selV = P(pg, "MainUI", "MainFrame", "Selected", "Vehicle")
    return selV and shown(selV)
end

local function spawnCar()
    if not isVehicleMenuOpen() then
        status("Mo menu xe...")
        local menuVehicle = P(pg, "MainUI", "MainFrame", "Menu", "Vehicle")
        if menuVehicle then
            click(menuVehicle)
            local t = os.clock()
            while os.clock() - t < 5 do
                if isVehicleMenuOpen() then break end
                task.wait(0.25)
            end
            task.wait(0.5)
        else
            print("   ⚠️ Không tìm thấy Menu.Vehicle")
            return nil
        end
    end

    if VEHICLE_NAME ~= "" then
        local list = P(pg, "MainUI", "MainFrame", "Selected", "Vehicle", "ListPane", "VehicleList")
        if list then
            local veh = list:FindFirstChild(VEHICLE_NAME)
            if veh then
                print("   🚗 Chọn xe:", VEHICLE_NAME)
                click(veh)
                task.wait(0.8)
            end
        end
    end

    status("Click Spawn...")
    task.wait(0.3)

    local spawnBtn = P(pg, "MainUI", "MainFrame", "Selected", "Vehicle", "Hero", "Acts", "Spawn")
    if not spawnBtn then
        local selV = P(pg, "MainUI", "MainFrame", "Selected", "Vehicle")
        if selV then
            for _, v in ipairs(selV:GetDescendants()) do
                if v:IsA("GuiButton") and v.Visible and v.AbsoluteSize.X > 20 then
                    local n = v.Name:lower()
                    local t = (v:IsA("TextButton") and v.Text or ""):lower()
                    if n:find("spawn") or t:find("spawn") then
                        spawnBtn = v
                        break
                    end
                end
            end
        end
    end

    if not spawnBtn then
        print("   ❌ Không tìm thấy nút Spawn")
        return nil
    end

    click(spawnBtn)
    status("Cho xe spawn...")
    task.wait(2)

    return waitFor(function()
        local c, s = findCar()
        if c then
            print("   ✅ Xe đã spawn:", c:GetFullName())
            return {c, s}
        end
    end, 20)
end

local function sit(seat)
    local ch  = lp.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not (hum and hrp) then return false end

    local car = seat:FindFirstAncestorOfClass("Model")
    local prompt
    if car then
        for _, v in ipairs(car:GetDescendants()) do
            if v:IsA("ProximityPrompt") and v.Enabled then
                prompt = v
                break
            end
        end
    end
    if not prompt then
        prompt = seat:FindFirstChildWhichIsA("ProximityPrompt", true)
    end

    if not prompt then
        print("   ⚠️ Không có ProximityPrompt → fallback sit")
        pcall(function() seat:Sit(hum) end)
        task.wait(1.5)
        return hum.SeatPart ~= nil
    end

    local holdDur = prompt.HoldDuration or 0
    print(string.format("   🪑 Prompt: %s | Hold: %.2fs", prompt:GetFullName(), holdDur))

    for attempt = 1, 6 do
        if hum.SeatPart then
            print("   ✅ Đã ngồi (SeatPart = " .. hum.SeatPart.Name .. ")")
            return true
        end

        local carCF = car and car:GetPivot() or seat.CFrame
        local sideOffset = carCF:VectorToWorldSpace(Vector3.new(4, 0, 0))
        local standPos = CFrame.new(seat.Position + sideOffset + Vector3.new(0, 2, 0))

        hrp.CFrame = standPos
        hum:ChangeState(Enum.HumanoidStateType.Running)
        task.wait(0.6)

        if fireproximityprompt then
            pcall(function() fireproximityprompt(prompt) end)
            task.wait(math.max(holdDur, 0.3) + 0.5)
        end

        if not hum.SeatPart then
            VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(math.max(holdDur, 0.5) + 0.3)
            VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            task.wait(0.5)
        end

        print(string.format("   🔄 Lần %d | Seated: %s", attempt, tostring(hum.SeatPart ~= nil)))
    end

    return hum.SeatPart ~= nil
end

local function setupRaceConstraints(root)
    for _, n in ipairs({"RaceAttachment", "RaceLinearVelocity", "RaceAlignOrientation"}) do
        local old = root:FindFirstChild(n)
        if old then old:Destroy() end
    end

    -- luc du de bam theo gia toc/phanh cua mo hinh (xe nang can luc lon hon)
    local force = MAX_FORCE
    if FORCE_PER_MASS > 0 then
        local okM, mass = pcall(function() return root.AssemblyMass end)
        if okM and type(mass) == "number" then force = math.max(force, mass * FORCE_PER_MASS) end
    end

    local att = Instance.new("Attachment")
    att.Name = "RaceAttachment"
    att.Parent = root

    local lv = Instance.new("LinearVelocity")
    lv.Name = "RaceLinearVelocity"
    lv.Attachment0 = att
    lv.MaxForce = force
    lv.VectorVelocity = Vector3.zero
    lv.RelativeTo = Enum.ActuatorRelativeTo.World
    pcall(function()
        lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
        lv.MaxAxesForce = Y_FORCE_FULL
            and Vector3.new(force, force, force)
            or  Vector3.new(force, 0, force)
    end)
    lv.Parent = root

    local ao = Instance.new("AlignOrientation")
    ao.Name = "RaceAlignOrientation"
    ao.Attachment0 = att
    ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
    ao.MaxTorque = MAX_FORCE
    ao.Responsiveness = math.clamp(AO_RESPONSIVE, 1, 200)
    ao.RigidityEnabled = false
    ao.Parent = root

    return lv, ao, att
end

local function cleanupRace(lv, ao, att)
    releaseKeys()
    if lv  then pcall(function() lv:Destroy()  end) end
    if ao  then pcall(function() ao:Destroy()  end) end
    if att then pcall(function() att:Destroy() end) end
end

