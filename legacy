local function findRaidEntry(list)
    if RAID_TELEPORT_NAME ~= "" then
        return list:FindFirstChild(RAID_TELEPORT_NAME)
    end
    local matches = {}
    for _, e in ipairs(list:GetChildren()) do
        if e.Name ~= "GP_Track_Race" then
            local txt = ""
            for _, d in ipairs(e:GetDescendants()) do
                if d:IsA("TextLabel") or d:IsA("TextButton") then txt = txt .. " " .. d.Text end
            end
            if (e.Name .. txt):lower():find("raid", 1, true) then matches[#matches + 1] = e end
        end
    end
    if #matches == 1 then return matches[1] end
    return nil
end

local function teleportToRaidArea()
    if not isTeleportOpen() then
        local menuTp = P(pg, "MainUI", "MainFrame", "Menu", "Teleport")
        if not menuTp then print("   ❌ Không thấy Menu.Teleport") return false end
        status("Mo UI Teleport...")
        click(menuTp)
        local t = os.clock()
        while running and os.clock() - t < 5 do
            if isTeleportOpen() then break end
            task.wait(0.25)
        end
        if not isTeleportOpen() then print("   ❌ UI Teleport không mở") return false end
        task.wait(0.5)
    end

    local tab = P(pg, "MainUI", "MainFrame", "Selected", "Teleport", "Tabs", "Races")
    if not tab then print("   ❌ Không thấy Tabs.Races") return false end
    click(tab)
    task.wait(0.6)

    local list
    local t = os.clock()
    while running and os.clock() - t < 5 do
        list = P(pg, "MainUI", "MainFrame", "Selected", "Teleport", "List")
        if list and #list:GetChildren() > 0 then break end
        task.wait(0.25)
    end
    if not list then print("   ❌ Không thấy Teleport.List") return false end

    local entry = findRaidEntry(list)
    if not entry then
        print("   ❌ Chưa xác định được mục teleport raid:")
        for _, e in ipairs(list:GetChildren()) do print("      -", e.Name, e.ClassName) end
        return false
    end

    local btn = entry:FindFirstChild("Button") or entry
    print("   🎯 Teleport tới mục:", entry.Name)
    status("Teleport: " .. entry.Name)
    click(btn)
    task.wait(WAIT_AFTER_TELEPORT)
    return true
end

local function driveToRaid(seat)
    local root = seat and seat.Parent and (seat.AssemblyRootPart or seat)
    if not root then return false end
    local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    local lv, ao, att = setupRaceConstraints(root)
    local t0, reached = os.clock(), false

    local cruise = rnd(RAID_SPEED_MIN, RAID_SPEED_MAX)
    local goal = RAID_POS + Vector3.new(rnd(-RAID_GOAL_JITTER, RAID_GOAL_JITTER), 0,
                                        rnd(-RAID_GOAL_JITTER, RAID_GOAL_JITTER))
    local arriveDist = RAID_ARRIVE_DIST

    local v, aLong, wS, rollF = 0, 0, 0, 0
    do
        local rv = root.AssemblyLinearVelocity
        v = math.min(Vector3.new(rv.X, 0, rv.Z).Magnitude, 60)
    end
    -- huong ban dau = huong xe dang quay (khong bi "bat" quay ngay)
    local vdir
    do
        local cf  = root.CFrame * CFrame.Angles(0, -math.rad(YAW), 0)
        local lvv = cf.LookVector * CAR_FORWARD_SIGN
        vdir = flatDir(Vector3.zero, Vector3.new(lvv.X, 0, lvv.Z), nil)
        if not vdir then vdir = flatDir(root.Position, goal, Vector3.new(0, 0, -1)) end
    end

    local ph = math.random() * 6.28
    local stopping, stopT0 = false, 0
    local sOn, sUntil, sNext = false, 0, 0
    local uiNext = 0

    while running and os.clock() - t0 < RAID_DRIVE_TIMEOUT do
        local dt  = math.min(RS.Heartbeat:Wait(), 0.05)
        local now = os.clock()
        if not seat.Parent or not root.Parent then break end
        if hum and not hum.SeatPart then break end

        local pos  = root.Position
        local to   = Vector3.new(goal.X - pos.X, 0, goal.Z - pos.Z)
        local dist = to.Magnitude

        -- toi noi (thay menu Quick hoac gan diem dich) -> tha ga, phanh em roi dung
        if not stopping and (getQuick() or dist <= arriveDist) then
            stopping, stopT0 = true, now
        end
        if stopping and (v < 3 or now - stopT0 > 5) then reached = true break end

        -- ---------- lai: quay dau co gioi han toc do quay ----------
        local want = dist > 0.5 and (to / dist) or vdir
        local crossY = vdir.Z * want.X - vdir.X * want.Z
        local dotV   = vdir.X * want.X + vdir.Z * want.Z
        local errA   = math.atan2(crossY, dotV)
        local wMax   = math.min(math.max(v / RAID_MIN_RADIUS, 0.3), A_LAT_MAX * 1.2 / math.max(v, 30))
        local w = 0
        if not stopping then
            w = math.clamp(RAID_HEADING_GAIN * errA + RAID_WOBBLE * math.sin(now * 0.9 + ph), -wMax, wMax)
        end
        vdir = rotY(vdir, w * dt)
        vdir = vdir.Magnitude > 0.01 and vdir.Unit or want
        wS = wS + (w - wS) * math.clamp(dt / 0.15, 0, 1)

        -- ---------- toc do muc tieu: cham lai khi can re gat / sap toi ----------
        local vt = 0
        if not stopping then
            local brakeV = math.sqrt(2 * RAID_DECEL * math.max(dist - arriveDist, 0)) + 6
            vt = math.min(cruise, brakeV) * math.clamp(1 - math.abs(errA) / 1.3, 0.3, 1)
        end
        local aT = math.clamp(SPEED_KP * (vt - v), -RAID_DECEL, RAID_ACCEL)
        local lim
        if aT > aLong then
            lim = (aLong >= 0) and JERK_UP or JERK_DOWN
        else
            lim = (aLong <= 0) and JERK_BRAKE or JERK_DOWN
        end
        aLong = aLong + math.clamp(aT - aLong, -lim * dt, lim * dt)
        v = v + aLong * dt
        if v < 0 then v = 0; if aLong < 0 then aLong = 0 end end

        if now - t0 > 1.5 then
            local rv = root.AssemblyLinearVelocity
            local vReal = rv.X * vdir.X + rv.Z * vdir.Z
            if v - vReal > SYNC_DEAD then
                v = v - (v - vReal - SYNC_DEAD) * math.clamp(SYNC_RATE * dt, 0, 1)
            end
        end

        lv.VectorVelocity = vdir * v

        -- ---------- than xe ----------
        local rollT = math.clamp(LEAN_FACTOR * math.atan(v * wS / 196.2),
            -math.rad(LEAN_MAX_DEG), math.rad(LEAN_MAX_DEG))
        rollF = rollF + (rollT - rollF) * math.clamp(dt / 0.12, 0, 1)
        local pitchA = math.rad(math.clamp(aLong * PITCH_PER_ACCEL, -PITCH_MAX_DEG, PITCH_MAX_DEG))
        ao.CFrame = CFrame.lookAt(Vector3.zero, vdir * CAR_FORWARD_SIGN)
            * CFrame.Angles(pitchA * CAR_FORWARD_SIGN, 0, rollF * CAR_FORWARD_SIGN)
            * CFrame.Angles(0, math.rad(YAW), 0)

        -- ---------- phim S nhap khi phanh ----------
        if USE_KEY_S then
            local Bk = math.clamp(-aLong / BRAKE_MAX, 0, 1)
            if sOn then
                if now >= sUntil or v < 5 then
                    setKey(Enum.KeyCode.S, false)
                    sOn = false
                    sNext = now + rnd(0.06, 0.18)
                end
            elseif Bk > BRAKE_KEY_THRESHOLD and v > BRAKE_KEY_MIN_SPEED and now >= sNext then
                setKey(Enum.KeyCode.S, true)
                sOn = true
                sUntil = now + math.clamp(0.10 + Bk * 0.45, 0.10, 0.5)
            end
        end

        if now >= uiNext then
            uiNext = now + 0.1
            lbProg.Text = string.format("Toi raid: %d stud", math.floor(dist))
            lbSpeed.Text = string.format("Toc do: %d", math.floor(v + 0.5))
        end
    end

    releaseKeys()
    if lv.Parent and root.Parent then
        smoothStop(lv, root, STOP_TIME_RAID)
        task.wait(0.3)
    end
    cleanupRace(lv, ao, att)
    return reached
end

local function mainLoop()
    local stopReason
    while running do
        local car, seat

        local c0, s0 = findCar()
        if c0 and s0 and s0.Parent and isSeatedIn(c0) then
            car, seat = c0, s0
            status("Dang ngoi tren xe, TP thang")
            print("   ♻️ Đang ngồi trên xe → bỏ qua spawn, TP thẳng")
        else
            print("   🚗 Không ngồi trên xe → spawn xe mới")
            status("Spawn xe...")
            local r = spawnCar()
            if not r then status("Khong spawn duoc, thu lai") task.wait(3) continue end
            car, seat = r[1], r[2]

            status("Đợi " .. WAIT_AFTER_SPAWN .. "s...")
            task.wait(WAIT_AFTER_SPAWN)

            status("Lại gần xe + giữ E...")
            if not sit(seat) then status("Khong ngoi duoc, thu lai") task.wait(3) continue end
            task.wait(rnd(0.5, 1))
        end

        if not teleportToRaidArea() then
            status("Khong vao duoc khu raid, thu lai")
            task.wait(3)
            continue
        end

        local r2 = waitFor(function()
            local c, s = findCar()
            if c and s and s.Parent then return {c, s} end
        end, 15)
        if not r2 then status("Mat xe sau teleport, lam lai") task.wait(2) continue end
        car, seat = r2[1], r2[2]

        local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
        if hum and not hum.SeatPart then
            status("Ngoi lai xe...")
            if not sit(seat) then status("Khong ngoi lai duoc, lam lai") task.wait(3) continue end
        end

        status("Lai xe den khu raid...")
        local arrived = driveToRaid(seat)
        if not running then break end
        if not arrived and not getQuick() then
            status("Chua toi khu raid, lam lai")
            task.wait(2)
            continue
        end

        status("Cho menu raid...")
        local q = waitFor(getQuick, 20)
        if not q then status("Menu khong hien, lam lai") task.wait(2) continue end
        task.wait(rnd(0.5, 1.2))
        click(q)

        for i = WAIT_AFTER_SOLO, 1, -1 do
            if not running then break end
            status("Cho bat dau: " .. i .. "s")
            task.wait(1)
        end
        if not running then break end

        if SPEED_RANDOM then
            SPEED = pickLapSpeed()
            refresh()
            print("   🎲 Tốc độ vòng này:", SPEED)
        end
        status("Dang dua...")
        local ok, why = runLap(car, seat)
        if why == "far_from_path" then
            stopReason = "Xe qua xa path, da dung"
            running = false
            break
        end
        status(ok and "Xong vong, cho Close..." or "Loi giua duong, lam lai")

        local c = waitFor(getClose, 20)
        if c then
            task.wait(rnd(CLOSE_DELAY_MIN, CLOSE_DELAY_MAX))
            click(c)
        end
        if ok then
            cycles += 1
            lbCycle.Text = "So vong da xong: " .. cycles
        end
        task.wait(AFTER_CLOSE_WAIT)
    end
    running = false
    releaseKeys()
    status(stopReason or "Da dung")
end

btnStart.MouseButton1Click:Connect(function()
    if running then return end
    if #pts < 2 then status("Chua doc duoc path") return end
    running = true
    task.spawn(mainLoop)
end)

btnStop.MouseButton1Click:Connect(function()
    releaseKeys()
    if running then
        running = false
        status("Dang dung...")
        task.spawn(function()
            task.wait(3)
            local _, seat = findCar()
            local root = seat and (seat.AssemblyRootPart or seat)
            if root then
                for _, n in ipairs({"RaceLinearVelocity", "RaceAlignOrientation", "RaceAttachment"}) do
                    local o = root:FindFirstChild(n)
                    if o then pcall(function() o:Destroy() end) end
                end
            end
            releaseKeys()
            status("Da dung")
        end)
    else
        local _, seat = findCar()
        local root = seat and (seat.AssemblyRootPart or seat)
        if root then
            for _, n in ipairs({"RaceLinearVelocity", "RaceAlignOrientation", "RaceAttachment"}) do
                local o = root:FindFirstChild(n)
                if o then pcall(function() o:Destroy() end) end
            end
        end
        status("Da dung")
    end
end)

