-- ---------------- Tiện ích ----------------
local cancel = false
local active = false
local noclipConn
local hbConn
local holdCF, tweening = nil, false   -- khóa vị trí khi đứng yên (chống trôi xuống do trọng lực)
local tries = {}         -- [Door] = số lần gõ thất bại
local done = {}          -- [Door] = thời điểm đã gõ
local lastUnderY, lastSafe

local function getRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
end

local function waitC(sec)
    local t0 = tick()
    while tick() - t0 < sec and not cancel do task.wait(0.05) end
end

local function setNoclip(on)
    if on then
        if noclipConn then return end
        noclipConn = RunService.Stepped:Connect(function()
            local c = LocalPlayer.Character
            if not c then return end
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end)
    elseif noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end
end

local function tweenTo(pos)
    local root = getRoot()
    if not root or not root.Parent then return false end
    local dist = (pos - root.Position).Magnitude
    if dist < 1 then holdCF = root.CFrame return true end
    local rot = root.CFrame - root.CFrame.Position
    local tween = TweenService:Create(root,
        TweenInfo.new(dist / math.max(cfg.speed, 1), Enum.EasingStyle.Linear),
        {CFrame = CFrame.new(pos) * rot})
    local finished = false
    local c = tween.Completed:Connect(function() finished = true end)
    tweening = true
    tween:Play()
    while not finished do
        if cancel or not root.Parent then tween:Cancel() break end
        task.wait(0.03)
    end
    c:Disconnect()
    tweening = false
    if finished and not cancel then holdCF = CFrame.new(pos) * rot end
    return finished and not cancel
end

-- ---------------- Cửa ----------------
local function getDoorFolder()
    local m = workspace:FindFirstChild("Map")
    local b = m and m:FindFirstChild("Buildings")
    return b and b:FindFirstChild("HasDoors")
end

local function posOf(inst)
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Model") then return inst:GetPivot().Position end
    local p = inst:FindFirstChildWhichIsA("BasePart", true)
    return p and p.Position
end

local function eventActive(door)
    local bb = door:FindFirstChild("HalloweenDoorBillboard")
    if not bb then return false end
    if bb:IsA("BillboardGui") and not bb.Enabled then return false end
    return true
end

-- Trả về điểm phía TRONG nhà và điểm phía NGOÀI cửa
local function doorPoints(building, door)
    local dpos = posOf(door)
    local dir
    if building:IsA("Model") then
        local ok, cf = pcall(function() return (building:GetBoundingBox()) end)
        if ok and cf then
            dir = Vector3.new(cf.Position.X - dpos.X, 0, cf.Position.Z - dpos.Z)
        end
    end
    if not dir or dir.Magnitude < 0.5 then
        local cf = door:IsA("BasePart") and door.CFrame or door:GetPivot()
        dir = -cf.LookVector * Vector3.new(1, 0, 1)
    end
    dir = dir.Unit
    return dpos + dir * cfg.inside, dpos - dir * 3
end

local function scanEvents()
    local list = {}
    local folder = getDoorFolder()
    if not folder then return list end
    for _, b in ipairs(folder:GetChildren()) do
        local door = b:FindFirstChild("Door")
        if door then
            if eventActive(door) then
                local t = done[door]
                if not t or tick() - t > REDO_AFTER then
                    list[#list + 1] = {building = b, door = door}
                end
            else
                done[door] = nil   -- cửa hết event → lần sau có lại thì tính là mới
            end
        end
    end
    return list
end

-- ---------------- Gõ cửa ----------------
local function holdE(sec)
    pcall(function() VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game) end)
    waitC(sec)
    pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game) end)
end

local function doKnock(door)
    local prompt0 = door:FindFirstChildWhichIsA("ProximityPrompt", true)
        or (door.Parent and door.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))
    if prompt0 and fireproximityprompt then
        local hold = prompt0.HoldDuration
        pcall(function() prompt0.HoldDuration = 0 end)
        pcall(fireproximityprompt, prompt0)
        pcall(function() prompt0.HoldDuration = hold end)
        print("[TT] fireproximityprompt:", prompt0:GetFullName())
        waitC(1)
        if not eventActive(door) then return end
    else
        print("[TT] Không thấy ProximityPrompt trong Door, dùng remote")
    end
    local okR, remote = pcall(function()
        return ReplicatedStorage.Extra.Remotes.RemoteFunction_InteractionFunction
    end)
    if okR and remote then
        task.spawn(function()
            local rr = getRoot()
            local dist = rr and math.floor((rr.Position - posOf(door)).Magnitude * 10) / 10
            local ok, res = pcall(function() return remote:InvokeServer(1, door) end)
            print("[TT] InvokeServer:", ok, res, "| cách cửa:", dist)
        end)
    end
    waitC(1.2)
    -- Nếu cửa vẫn còn event → thử giữ E / fireproximityprompt
    if not cancel and eventActive(door) then
        local prompt = door:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt and fireproximityprompt then pcall(fireproximityprompt, prompt) end
        print("[TT] Giữ E thật")
        holdE(prompt and (math.max(prompt.HoldDuration, 0.3) + 0.2) or 1.5)
    end
end

local function visitDoor(entry)
    local root, hum = getRoot()
    if not root then return false end
    local inside, outside = doorPoints(entry.building, entry.door)
    local underY = inside.Y - cfg.depth
    lastUnderY, lastSafe = underY, outside

    if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end) end
    setNoclip(true)

    -- 1) chìm xuống   2) bay ngang dưới đất   3) trồi lên trong nhà
    if not tweenTo(Vector3.new(root.Position.X, underY, root.Position.Z)) then return false end
    if not tweenTo(Vector3.new(inside.X, underY, inside.Z)) then return false end
    if not tweenTo(inside) then return false end

    doKnock(entry.door)
    waitC(cfg.stay)
    if eventActive(entry.door) then
        tries[entry.door] = (tries[entry.door] or 0) + 1
        print("[TT] Gõ chưa ăn, lần thử:", tries[entry.door])
        if tries[entry.door] >= 3 then
            done[entry.door] = tick()
            tries[entry.door] = nil
        end
    else
        done[entry.door] = tick()
        tries[entry.door] = nil
    end
    return true
end

local function cleanup()
    if hbConn then hbConn:Disconnect() hbConn = nil end
    holdCF = nil
    setNoclip(false)
    local root, hum = getRoot()
    if root then
        -- đang ở dưới đất thì đưa lên ngoài cửa gần nhất cho an toàn
        if lastSafe and lastUnderY and root.Position.Y < lastUnderY + 10 then
            root.CFrame = CFrame.new(lastSafe + Vector3.new(0, 3, 0))
        end
        root.Anchored = false
        root.CanCollide = true
        root.AssemblyLinearVelocity = Vector3.zero
    end
    if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
end

local function mainLoop()
    while not cancel and env.TTGen == myGen do
        local root = getRoot()
        if not root then
            setStatus("Chờ nhân vật hồi sinh...", Color3.fromRGB(255, 200, 0))
            waitC(1)
        else
            local list = scanEvents()
            if #list == 0 then
                setStatus("Hết cửa event, chờ cửa mới...", Color3.fromRGB(255, 200, 0))
                if lastUnderY and root.Position.Y > lastUnderY + 5 then
                    tweenTo(Vector3.new(root.Position.X, lastUnderY, root.Position.Z))
                end
                waitC(2)
            else
                -- chọn cửa gần nhất
                table.sort(list, function(a, b)
                    local pa, pb = posOf(a.door), posOf(b.door)
                    return (pa - root.Position).Magnitude < (pb - root.Position).Magnitude
                end)
                setStatus(("Còn %d cửa → đi gõ %s"):format(#list, list[1].building.Name), Color3.fromRGB(0, 255, 100))
                if not visitDoor(list[1]) and not cancel then
                    done[list[1].door] = tick()   -- lỗi thì bỏ qua cửa này, tránh kẹt
                    waitC(1)
                end
            end
        end
    end
end

local function styleToggle()
    btnToggle.Text = "AUTO GÕ CỬA: " .. (cfg.enabled and "BẬT" or "TẮT")
    btnToggle.BackgroundColor3 = cfg.enabled and C_ON or C_BAD
end

local function startRun()
    if active then return end
    active = true
    cancel = false
    if hbConn then hbConn:Disconnect() end
    hbConn = RunService.Heartbeat:Connect(function()
        local r, h = getRoot()
        if h and h.Health <= 0 then holdCF = nil end
        if r then
            r.AssemblyLinearVelocity = Vector3.zero
            if holdCF and not tweening then r.CFrame = holdCF end
        end
    end)
    task.spawn(function()
        local ok, err = xpcall(mainLoop, function(e) return tostring(e) .. "\n" .. debug.traceback() end)
        if not ok then
            warn("[TT] Lỗi: " .. tostring(err))
            setStatus("Lỗi: " .. tostring(err):match("^[^\n]*"), Color3.fromRGB(255, 80, 80))
        end
        cleanup()
        active = false
        if not cfg.enabled then setStatus("Đã dừng", Color3.fromRGB(255, 80, 80)) end
    end)
end

btnToggle.MouseButton1Click:Connect(function()
    cfg.enabled = not cfg.enabled
    styleToggle()
    saveConfig()
    if cfg.enabled then startRun() else cancel = true end
end)

