local CONFIG_FILE = "TrickTreat_Config.json"
local cfg = {
    enabled = false,
    speed   = 300,   -- tốc độ tween
    depth   = 30,    -- độ sâu dưới mặt đất khi di chuyển (stud)
    inside  = 4,     -- chui vào trong nhà cách cửa bao nhiêu stud
    stay    = 1.5,   -- đứng trong nhà bao lâu sau khi gõ (giây) - để nhận thưởng/đánh quái
}
local REDO_AFTER = 290  -- cửa đã gõ: sau chừng này giây thì cho phép gõ lại (reset 5 phút)

local function saveConfig()
    if not writefile then return end
    pcall(function() writefile(CONFIG_FILE, HttpService:JSONEncode(cfg)) end)
end
local function loadConfig()
    if not (isfile and readfile and isfile(CONFIG_FILE)) then return end
    local ok, d = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
    if not ok or type(d) ~= "table" then return end
    if type(d.enabled) == "boolean" then cfg.enabled = d.enabled end
    if type(d.speed)  == "number" then cfg.speed  = math.clamp(d.speed, 50, 2000) end
    if type(d.depth)  == "number" then cfg.depth  = math.clamp(d.depth, 5, 150) end
    if type(d.inside) == "number" then cfg.inside = math.clamp(d.inside, -10, 30) end
    if type(d.stay)   == "number" then cfg.stay   = math.clamp(d.stay, 0, 10) end
end
