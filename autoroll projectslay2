-- ===== HELPER FUNCTIONS =====
local function getData()
    return ReplicatedStorage
        :FindFirstChild("Player_Service")
        :FindFirstChild("Data")
        :FindFirstChild(LocalPlayer.Name)
        :FindFirstChild("slots")
        :FindFirstChild("Slot1")
end

local function getClan()
    local d = getData()
    return d and d.Clan and d.Clan.Value or nil
end

local function getSpins()
    local d = getData()
    return d and d.Spinning and d.Spinning.FreeClanSpins and d.Spinning.FreeClanSpins.Value or 0
end

local function isSupreme(name)
    return SUPREME_CLANS[name] == true
end

-- ===== AUTO ROLL =====
local isRolling = false

local function autoRoll()
    isRolling = true
    local count = 0

    while isRolling do
        local spins = getSpins()
        SpinsLbl.Text = "Spins còn: " .. spins

        if spins <= 0 then
            Status.Text = "❌ Hết spins!"
            Status.TextColor3 = Color3.fromRGB(255, 100, 100)
            break
        end

        Status.Text = "🔄 Đang quay..."
        Status.TextColor3 = Color3.fromRGB(255, 220, 100)

        local ok, err = pcall(function()
            SignalFunction:InvokeServer("ClanSpin")
        end)

        if not ok then
            Status.Text = "❌ Lỗi: " .. tostring(err):sub(1, 40)
            Status.TextColor3 = Color3.fromRGB(255, 100, 100)
            break
        end

        count = count + 1
        RollsLbl.Text = "Đã quay: " .. count .. " lần"

        -- Đợi server update
        task.wait(1.2)

        local clan = getClan()
        if clan then
            ClanLbl.Text = "Clan: " .. clan
        end

        if stopOnSupreme and clan and isSupreme(clan) then
            Status.Text = "🎉 SUPREME: " .. clan
            Status.TextColor3 = Color3.fromRGB(255, 215, 0)
            ClanLbl.TextColor3 = Color3.fromRGB(255, 215, 0)

            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "🎉 SUPREME!",
                Text = clan .. " sau " .. count .. " lần quay",
                Duration = 10,
            })
            break
        end

        task.wait(0.3)
    end

    isRolling = false
    StartBtn.Text = "▶️ BẮT ĐẦU"
    StartBtn.BackgroundColor3 = Color3.fromRGB(60, 120, 220)
end

StartBtn.MouseButton1Click:Connect(function()
    if isRolling then
        isRolling = false
    else
        StartBtn.Text = "⏹️ DỪNG"
        StartBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
        task.spawn(autoRoll)
    end
end)

