-- ===== DELAY CONTROL =====
local rollDelay = 1 -- Mặc định 0.8s, đủ để game animation chạy
local delayStep = 0.1
local delayMin = 0.3
local delayMax = 3.0

local function updateDelayUI()
    local rounded = math.floor(rollDelay * 10 + 0.5) / 10
    DelayValLbl.Text = rounded .. "s"
    DelayLbl.Text = "⏱ Delay mỗi roll: " .. rounded .. "s"
end

BtnMinus.MouseButton1Click:Connect(function()
    rollDelay = math.max(delayMin, rollDelay - delayStep)
    updateDelayUI()
end)

BtnPlus.MouseButton1Click:Connect(function()
    rollDelay = math.min(delayMax, rollDelay + delayStep)
    updateDelayUI()
end)

-- ===== HELPERS =====
local function getSlot()
    local data = RS:FindFirstChild("Player_Service"):FindFirstChild("Data"):FindFirstChild(LP.Name)
    if not data then return nil end
    local equipped = data.slotEquipped and data.slotEquipped.Value or 1
    return data.slots["Slot" .. equipped]
end

local function getClan()
    local s = getSlot()
    return s and s.Clan and s.Clan.Value or nil
end

local function getSpins()
    local s = getSlot()
    return s and s.Spinning and s.Spinning.Spins.Value or 0
end

local function isSupreme(name)
    return SUPREME_CLANS[name] == true
end

-- ===== AUTO ROLL =====
local isRolling = false

local function autoRoll()
    isRolling = true
    local count = 0

    while isRolling do
        local spins = getSpins()
        SpinsLbl.Text = "Spins còn: " .. spins

        if spins <= 0 then
            Status.Text = "❌ Hết spins! Đã quay " .. count .. " lần."
            Status.TextColor3 = Color3.fromRGB(255,100,100)
            break
        end

        Status.Text = "🔄 Đang quay..."
        Status.TextColor3 = Color3.fromRGB(255,220,100)

        local clanBefore = getClan()
        local spinsBefore = getSpins()

        local ok = pcall(function() SF:InvokeServer("ClanSpin") end)
        if not ok then
            Status.Text = "❌ Lỗi gửi ClanSpin"
            break
        end

        -- Đợi animation game chạy xong theo delay người dùng chọn
        task.wait(rollDelay)

        pcall(function() SE:FireServer("ClanSpinComplete") end)

        -- Poll chờ server cập nhật clan (tối đa 5 giây)
        local timeout = tick() + 5
        while tick() < timeout do
            task.wait(0.05)
            if getClan() ~= clanBefore and getSpins() < spinsBefore then
                break
            end
        end

        count = count + 1
        RollsLbl.Text = "Đã quay: " .. count .. " lần"

        local clan = getClan()
        local newSpins = getSpins()
        if clan then
            ClanLbl.Text = "Clan: " .. clan
            ClanLbl.TextColor3 = Color3.fromRGB(100,255,100)
        end
        SpinsLbl.Text = "Spins còn: " .. newSpins

        if clan and isSupreme(clan) then
            Status.Text = "🎉 SUPREME: " .. clan
            Status.TextColor3 = Color3.fromRGB(255, 215, 0)
            ClanLbl.TextColor3 = Color3.fromRGB(255, 215, 0)
            pcall(function()
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "🎉 SUPREME FOUND!",
                    Text = clan .. " sau " .. count .. " lần",
                    Duration = 10,
                })
            end)
            break
        end

        -- Đợi thêm 0.3s giữa các lần roll để ổn định
        task.wait(0.3)
    end

    isRolling = false
    StartBtn.Text = "▶️ BẮT ĐẦU"
    StartBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 180)
end

StartBtn.MouseButton1Click:Connect(function()
    if isRolling then
        isRolling = false
        Status.Text = "⏹ Đã dừng."
        Status.TextColor3 = Color3.fromRGB(200,200,200)
    else
        StartBtn.Text = "⏹️ DỪNG"
        StartBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
        task.spawn(autoRoll)
    end
end)

