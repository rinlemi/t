    logScroll.CanvasSize=UDim2.new(0,0,0,logLayout.AbsoluteContentSize.Y+8)
end)

-- ===================== HELPERS =====================
local function isTarget(clan)
    for _, target in ipairs(TARGET_CLANS) do
        if string.lower(tostring(clan))==string.lower(target) then return true end
    end
    return false
end

local function spinSlot(slot)
    local ok, result = pcall(function()
        return SPIN_REMOTE:InvokeServer("Clans", {IndexSlot=slot})
    end)
    if not ok then return nil end
    if type(result) == "string" then return result end
    if type(result) == "table" then return result.Name or result.Clan or result[1] or nil end
    return nil
end

