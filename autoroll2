    local n1=lbl(notif,"✅  SLOT "..slot.." - "..string.upper(clan).."!",14,C.green,Enum.TextXAlignment.Center); n1.Size=UDim2.new(1,0,0,24)
    local n2=lbl(notif,"Tổng spin: "..spinCount.."  •  Đang ở lại server",11,C.white,Enum.TextXAlignment.Center); n2.Size=UDim2.new(1,0,0,20); n2.Position=UDim2.new(0,0,0,28)
    local n3=lbl(notif,"🎉 Không rejoin - Giữ clan này!",9,C.yellow,Enum.TextXAlignment.Center); n3.Size=UDim2.new(1,0,0,14); n3.Position=UDim2.new(0,0,0,52)
end

local function doRejoin()
    addLog("🔄 Đủ "..MAX_SPINS.." spin - Rejoin...", C.yellow)
    statusLbl.Text="🔄 Đang rejoin..."; statusLbl.TextColor3=C.yellow
    task.wait(2)
    pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
    end)
end

local function setSpinState(on)
    spinning=on
    if on then
        startBtn.Text="⏹  DỪNG SPIN"; startBtn.BackgroundColor3=C.red; startBtn.TextColor3=Color3.fromRGB(255,255,255)
        statusLbl.Text="🔄 Đang spin..."; statusLbl.TextColor3=C.yellow
    else
        startBtn.Text="▶  BẮT ĐẦU SPIN"; startBtn.BackgroundColor3=C.green; startBtn.TextColor3=Color3.fromRGB(10,10,20)
    end
end

-- ===================== MAIN LOOP =====================
local function startLoop()
    if spinning then return end
    spinCount=0
    setSpinState(true)
    addLog("── BẮT ĐẦU SPIN (slot 1 + 2) ──", C.accent)

    task.spawn(function()
        while spinning do

            -- === SLOT 1 ===
            statusLbl.Text="🎰 Đang roll slot 1..."; statusLbl.TextColor3=C.cyan
            local clan1 = spinSlot(1)
            spinCount+=1
            countLbl.Text="🔄  Spins: "..spinCount.." / "..MAX_SPINS

            if clan1 then
                local hit1 = isTarget(clan1)
                slot1Lbl.Text="🎰  Slot 1: "..clan1; slot1Lbl.TextColor3=hit1 and C.green or C.white
                addLog(string.format("[%d] S1: %s", spinCount, clan1), hit1 and C.green or C.muted)

                if hit1 then
                    spinning=false
                    addLog("✅ SLOT 1 FOUND: "..clan1.." sau "..spinCount.." spin!", C.green)
                    statusLbl.Text="✅ SLOT 1: "..clan1.." - Ở lại!"; statusLbl.TextColor3=C.green
                    setSpinState(false)
                    showFoundNotif(clan1, 1)
                    return
                end
            else
                slot1Lbl.Text="🎰  Slot 1: (lỗi)"; slot1Lbl.TextColor3=C.yellow
                addLog(string.format("[%d] S1: (lỗi)", spinCount), C.yellow)
            end

            -- Check max sau slot 1
            if spinCount >= MAX_SPINS then
                spinning=false; setSpinState(false); doRejoin(); return
            end

            task.wait(SLOT_GAP)
            if not spinning then break end

            -- === SLOT 2 ===
            statusLbl.Text="🎰 Đang roll slot 2..."; statusLbl.TextColor3=C.cyan
            local clan2 = spinSlot(2)
            spinCount+=1
            countLbl.Text="🔄  Spins: "..spinCount.." / "..MAX_SPINS

            if clan2 then
                local hit2 = isTarget(clan2)
                slot2Lbl.Text="🎰  Slot 2: "..clan2; slot2Lbl.TextColor3=hit2 and C.green or C.white
                addLog(string.format("[%d] S2: %s", spinCount, clan2), hit2 and C.green or C.muted)

                if hit2 then
                    spinning=false
                    addLog("✅ SLOT 2 FOUND: "..clan2.." sau "..spinCount.." spin!", C.green)
                    statusLbl.Text="✅ SLOT 2: "..clan2.." - Ở lại!"; statusLbl.TextColor3=C.green
                    setSpinState(false)
                    showFoundNotif(clan2, 2)
                    return
                end
            else
                slot2Lbl.Text="🎰  Slot 2: (lỗi)"; slot2Lbl.TextColor3=C.yellow
                addLog(string.format("[%d] S2: (lỗi)", spinCount), C.yellow)
            end

            -- Check max sau slot 2
            if spinCount >= MAX_SPINS then
                spinning=false; setSpinState(false); doRejoin(); return
            end

            task.wait(SPIN_DELAY)
        end

        if not statusLbl.Text:find("FOUND") and not statusLbl.Text:find("rejoin") then
            addLog("── DỪNG sau "..spinCount.." spin ──", C.muted)
            statusLbl.Text="⏹ Dừng sau "..spinCount.." spin"; statusLbl.TextColor3=C.muted
        end
        setSpinState(false)
    end)
end

startBtn.MouseButton1Click:Connect(function()
    if spinning then spinning=false
    else startLoop() end
end)

-- ===================== AUTO START 15S =====================
task.spawn(function()
    for i = 15, 1, -1 do
        if spinning then return end
        statusLbl.Text="⏳ Tự động bắt đầu sau "..i.."s..."; statusLbl.TextColor3=C.yellow
        task.wait(1)
    end
    if not spinning then
        addLog("── AUTO START sau 15s ──", C.accent)
        startLoop()
    end
end)

