-- ===================== LOG SYSTEM =====================
local logOrder = 0
local function addLog(text, color)
    logOrder += 1
    local row = Instance.new("Frame", logScroll)
    row.Size = UDim2.new(1,-6,0,16); row.BackgroundTransparency=1; row.BorderSizePixel=0
    row.LayoutOrder = logOrder
    local l = Instance.new("TextLabel", row)
    l.Size = UDim2.new(1,0,1,0); l.BackgroundTransparency=1
    l.Text = string.sub(tostring(text), 1, 100)
    l.TextColor3 = color or C.muted; l.TextSize=9
    l.Font=Enum.Font.Code; l.TextXAlignment=Enum.TextXAlignment.Left
    l.TextTruncate=Enum.TextTruncate.AtEnd
    logScroll.CanvasSize=UDim2.new(0,0,0,logLayout.AbsoluteContentSize.Y+8)
    logScroll.CanvasPosition=Vector2.new(0, math.max(0, logLayout.AbsoluteContentSize.Y-185))
end

