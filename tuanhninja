local function corner(r, obj)
    local c = Instance.new("UICorner", obj); c.CornerRadius = UDim.new(0,r)
end
local function stroke(obj, color, thick)
    local s = Instance.new("UIStroke", obj); s.Color = color or C.border; s.Thickness = thick or 1
end
local function lbl(parent, text, size, color, xAlign)
    local l = Instance.new("TextLabel", parent)
    l.BackgroundTransparency = 1
    l.Text = text; l.TextColor3 = color or C.white
    l.TextSize = size or 12; l.Font = Enum.Font.GothamBold
    l.TextXAlignment = xAlign or Enum.TextXAlignment.Center
    return l
end

