-- ===================== SPIN =====================
local function doSpin()
    local ok, result = pcall(function()
        return SPIN_REMOTE:InvokeServer("Clans", {IndexSlot=1})
    end)
    if not ok then
        statusLbl.Text="❌ Remote lỗi: "..tostring(result); statusLbl.TextColor3=C.red
        return false, nil
    end
    local clanName = nil
    if type(result) == "string" then
        clanName = result
    elseif type(result) == "table" then
        clanName = result.Name or result.Clan or result[1] or nil
    end
    return true, clanName
end

local function showFoundNotif()
    local notif=Instance.new("Frame",gui)
    notif.Size=UDim2.new(0,320,0,80); notif.Position=UDim2.new(0.5,-160,0,16)
    notif.BackgroundColor3=Color3.fromRGB(10,35,15); notif.BorderSizePixel=0
    corner(12,notif); stroke(notif,C.green,2)
    local np=Instance.new("UIPadding",notif); np.PaddingTop=UDim.new(0,10); np.PaddingLeft=UDim.new(0,10); np.PaddingRight=UDim.new(0,10)
    local n1=lbl(notif,"✅  CLAN "..string.upper(TARGET_CLAN).." ĐÃ RA!",15,C.green,Enum.TextXAlignment.Center); n1.Size=UDim2.new(1,0,0,24)
    local n2=lbl(notif,"Tổng spin: "..spinCount.."  •  Script đã dừng",11,C.white,Enum.TextXAlignment.Center); n2.Size=UDim2.new(1,0,0,20); n2.Position=UDim2.new(0,0,0,28)
    local n3=lbl(notif,"(Tự đóng sau 10 giây)",9,C.muted,Enum.TextXAlignment.Center); n3.Size=UDim2.new(1,0,0,14); n3.Position=UDim2.new(0,0,0,52)
    task.delay(10,function() if notif and notif.Parent then notif:Destroy() end end)
end

local function setSpinState(on)
    spinning=on
    if on then
        startBtn.Text="⏹  DỪNG SPIN"
        startBtn.BackgroundColor3=C.red
        startBtn.TextColor3=Color3.fromRGB(255,255,255)
        statusLbl.Text="🔄 Đang spin..."; statusLbl.TextColor3=C.yellow
    else
        startBtn.Text="▶  BẮT ĐẦU SPIN"
        startBtn.BackgroundColor3=C.green
        startBtn.TextColor3=Color3.fromRGB(10,10,20)
    end
end

local function startLoop()
    if spinning then return end
    spinCount=0
    setSpinState(true)

    task.spawn(function()
        while spinning do
            local ok, clan = doSpin()
            if not ok then spinning=false; break end
            spinCount+=1
            countLbl.Text="🔄  Spins: "..spinCount

            if clan then
                resultLbl.Text="👁  Last: "..clan; resultLbl.TextColor3=C.white
                statusLbl.Text="🎰 Ra: "..clan; statusLbl.TextColor3=C.cyan

                if string.lower(clan)==string.lower(TARGET_CLAN) then
                    spinning=false
                    statusLbl.Text="✅ FOUND: "..clan.." sau "..spinCount.." lần!"; statusLbl.TextColor3=C.green
                    setSpinState(false)
                    showFoundNotif()
                    break
                end
            else
                resultLbl.Text="👁  Last: (lỗi)"; resultLbl.TextColor3=C.yellow
                statusLbl.Text="⚠ Không đọc được, thử tiếp..."; statusLbl.TextColor3=C.yellow
            end

            task.wait(SPIN_DELAY)
        end

        if not statusLbl.Text:find("FOUND") then
            statusLbl.Text="⏹ Dừng sau "..spinCount.." spin"; statusLbl.TextColor3=C.muted
        end
        setSpinState(false)
    end)
end

startBtn.MouseButton1Click:Connect(function()
    if spinning then spinning=false
    else startLoop() end
end)

print("✅ AutoSpin Clan v2.1 loaded | Target: "..TARGET_CLAN)
