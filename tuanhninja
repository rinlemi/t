-- ===================== DETECT CLAN RESULT =====================
local function getCurrentClanName()
    -- Đọc tên clan từ ImagesFrame.Clan1 (children của ImagesFrame là Frame tên = clan name)
    local ok, slotContainer = pcall(function()
        return player.PlayerGui
            :WaitForChild("Interface",1)
            :WaitForChild("GachaSelectedFrame",1)
            :WaitForChild("ClanFrame",1)
            :WaitForChild("SlotContainer",1)
            :WaitForChild("Clan1",1)
            :WaitForChild("ImagesFrame",1)
    end)
    if not ok or not slotContainer then return nil end

    for _, child in ipairs(slotContainer:GetChildren()) do
        -- child.Visible = true nếu đang hiển thị clan này
        local visOk, vis = pcall(function() return child.Visible end)
        if visOk and vis and child:IsA("Frame") then
            return child.Name
        end
    end
    return nil
end

-- ===================== SPIN FUNCTION =====================
local function doSpin()
    local ok, err = pcall(function()
        SPIN_REMOTE:InvokeServer("Clans", { IndexSlot = 1 })
    end)
    if not ok then
        statusLbl.Text = "❌ Remote lỗi: " .. tostring(err)
        statusLbl.TextColor3 = C.red
        return false
    end
    return true
end

-- ===================== MAIN SPIN LOOP =====================
local function startSpinLoop()
    if spinning then return end
    spinning = true
    spinCount = 0
    stopReason = nil

    startBtn.Text = "⏹  DỪNG SPIN"
    startBtn.BackgroundColor3 = C.red
    startBtn.TextColor3 = Color3.fromRGB(255,255,255)
    statusLbl.Text = "🔄 Đang spin..."; statusLbl.TextColor3 = C.yellow

    task.spawn(function()
        while spinning do
            -- Thực hiện spin
            local ok = doSpin()
            if not ok then spinning = false; break end

            spinCount += 1
            countLbl.Text = "🔄  Spins: " .. spinCount

            -- Chờ UI cập nhật kết quả
            task.wait(SPIN_DELAY)

            -- Kiểm tra kết quả
            local clanName = getCurrentClanName()
            if clanName then
                statusLbl.Text = "👁  Kết quả: " .. clanName; statusLbl.TextColor3 = C.cyan
                if string.lower(clanName) == string.lower(TARGET_CLAN) then
                    -- FOUND!
                    spinning = false
                    stopReason = "found"
                    break
                end
            else
                statusLbl.Text = "⚠ Không đọc được clan result"; statusLbl.TextColor3 = C.yellow
            end

            task.wait(0.1) -- thêm buffer nhỏ tránh spam
        end

        -- Kết thúc loop
        if stopReason == "found" then
            statusLbl.Text = "✅ FOUND: " .. TARGET_CLAN .. "! (Spin: " .. spinCount .. ")"
            statusLbl.TextColor3 = C.green

            -- Notification overlay
            local notif = Instance.new("Frame", gui)
            notif.Size = UDim2.new(0,300,0,70)
            notif.Position = UDim2.new(0.5,-150,0,20)
            notif.BackgroundColor3 = Color3.fromRGB(20,40,20)
            notif.BorderSizePixel = 0
            corner(10, notif); stroke(notif, C.green, 2)
            local np = Instance.new("UIPadding", notif)
            np.PaddingLeft=UDim.new(0,10); np.PaddingTop=UDim.new(0,10); np.PaddingRight=UDim.new(0,10)
            local nl1 = lbl(notif, "✅  CLAN " .. string.upper(TARGET_CLAN) .. " ĐÃ RA!", 14, C.green, Enum.TextXAlignment.Center)
            nl1.Size = UDim2.new(1,0,0,22)
            local nl2 = lbl(notif, "Tổng số lần spin: " .. spinCount, 11, C.white, Enum.TextXAlignment.Center)
            nl2.Size = UDim2.new(1,0,0,18); nl2.Position = UDim2.new(0,0,0,26)
            local nl3 = lbl(notif, "Script đã dừng tự động!", 10, C.muted, Enum.TextXAlignment.Center)
            nl3.Size = UDim2.new(1,0,0,14); nl3.Position = UDim2.new(0,0,0,46)
            -- auto-hide sau 8 giây
            task.delay(8, function()
                if notif and notif.Parent then notif:Destroy() end
            end)
        else
            statusLbl.Text = "⏹ Đã dừng (" .. spinCount .. " lần spin)"; statusLbl.TextColor3 = C.muted
        end

        startBtn.Text = "▶  BẮT ĐẦU SPIN"
        startBtn.BackgroundColor3 = C.green
        startBtn.TextColor3 = Color3.fromRGB(10,10,20)
    end)
end

local function stopSpinLoop()
    spinning = false
    statusLbl.Text = "⏹ Người dùng dừng (" .. spinCount .. " lần)"; statusLbl.TextColor3 = C.muted
    startBtn.Text = "▶  BẮT ĐẦU SPIN"
    startBtn.BackgroundColor3 = C.green
    startBtn.TextColor3 = Color3.fromRGB(10,10,20)
end

startBtn.MouseButton1Click:Connect(function()
    if spinning then
        stopSpinLoop()
    else
        startSpinLoop()
    end
end)

print("✅ AutoSpin Clan loaded - Target: " .. TARGET_CLAN)
