    local ok, saved = T.saveConfig(name, saveData)
    if ok then T.settings.selected = saved T.saveSettings() box.Text = "" refresh() T.status("Đã lưu: " .. saved) else T.status("Lưu lỗi") end
end)

local r2 = row(32)
btn(r2, "Chạy", 1, 3, function()
    local cfg = (T.settings.selected ~= "") and T.loadConfig(T.settings.selected) or nil
    if not cfg then T.status("Chưa chọn config"); return end
    if cfg.settings then
        T.settings.autoStart = cfg.settings.autoStart T.settings.autoReplay = cfg.settings.autoReplay T.settings.autoSkip = cfg.settings.autoSkip T.settings.autoPlay = cfg.settings.autoPlay
        for _, child in ipairs(body:GetChildren()) do
            if child:IsA("TextButton") and child.Text:find("Auto") then
                local key = child.Text:match("Auto (%w+)")
                if key then key = string.lower(key:sub(1,1)) .. key:sub(2) child.Text = "Auto " .. key:sub(1,1):upper() .. key:sub(2) .. ": " .. (T.settings[key] and "BẬT" or "TẮT") child.BackgroundColor3 = T.settings[key] and ON or OFF end
            end
        end
    end
    T.play(cfg)
end)
btn(r2, "Dừng", 2, 3, function() T.stopPlay() end)
btn(r2, "Xóa", 3, 3, function() if T.settings.selected == "" then return end T.deleteConfig(T.settings.selected) T.status("Đã xóa: " .. T.settings.selected) T.settings.selected = "" T.saveSettings() refresh() end)

local function toggle(label, key)
    local b
    local function paint() b.Text = label .. ": " .. (T.settings[key] and "BẬT" or "TẮT") b.BackgroundColor3 = T.settings[key] and ON or OFF end
    b = btn(row(28), label, 1, 1, function() T.settings[key] = not T.settings[key] T.saveSettings() paint() end)
    paint()
end
toggle("Auto Start", "autoStart")
toggle("Auto Replay", "autoReplay")
toggle("Auto Skip Wave", "autoSkip")
toggle("Auto chạy config", "autoPlay")

