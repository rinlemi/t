local function mk(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end

local BG, BTN = Color3.fromRGB(28, 28, 36), Color3.fromRGB(60, 60, 74)
local ON, OFF = Color3.fromRGB(50, 150, 80), Color3.fromRGB(70, 70, 82)
local FIELD = Color3.fromRGB(40, 40, 52)

