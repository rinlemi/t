local S2C = EP and EP:WaitForChild("server_to_client", 10)

local ROOT, CFG = "TuanhHub", "TuanhHub/configs"
if not isfolder(ROOT) then makefolder(ROOT) end
if not isfolder(CFG) then makefolder(CFG) end

local T = {
	wave = 1, waveStart = os.clock(),
	recording = false, playing = false, playToken = 0,
	rec = {}, slots = {}, nextSlot = 1,
	finished = false, replayed = false, replayedAt = 0, lastBegin = 0,
	settings = { autoStart = false, autoReplay = false, autoSkip = false, autoPlay = false, selected = "", webhook = "" },
	conns = {}, paints = {}, gui = nil,
}
getgenv().TuanhMacro = T

function T.status(t)
	print("[Tuanh] " .. tostring(t))
	if T.statusLbl then pcall(function() T.statusLbl.Text = tostring(t) end) end
end

function T.cleanup()
	T.dead = true
	T.recording = false
	T.playToken = T.playToken + 1
	T.playing = false
	for _, c in ipairs(T.conns) do pcall(function() c:Disconnect() end) end
	if T.gui then pcall(function() T.gui:Destroy() end) end
end

-- ================= FILE =================
function T.cleanName(n)
	n = tostring(n or ""):gsub('[\\/:*?"<>|]', "")
	n = n:gsub("^%s+", ""):gsub("%s+$", "")
	return n
end

function T.listConfigs()
	local out = {}
	local ok, files = pcall(listfiles, CFG)
	if ok and type(files) == "table" then
		for _, f in ipairs(files) do
			local n = tostring(f):match("([^/\\]+)%.json$")
			if n then table.insert(out, n) end
		end
	end
	table.sort(out)
	return out
end

function T.saveConfig(name, data)
	name = T.cleanName(name)
	if name == "" then return false end
	return pcall(writefile, CFG .. "/" .. name .. ".json", HttpService:JSONEncode(data)), name
end

function T.loadConfig(name)
	local p = CFG .. "/" .. tostring(name) .. ".json"
	if not isfile(p) then return nil end
	local ok, r = pcall(function() return HttpService:JSONDecode(readfile(p)) end)
	if ok then return r end
	return nil
end

function T.deleteConfig(name)
	if delfile then pcall(delfile, CFG .. "/" .. tostring(name) .. ".json") end
end

function T.saveSettings()
	pcall(writefile, ROOT .. "/settings.json", HttpService:JSONEncode(T.settings))
end

function T.loadSettings()
	if isfile(ROOT .. "/settings.json") then
		local ok, r = pcall(function() return HttpService:JSONDecode(readfile(ROOT .. "/settings.json")) end)
		if ok and type(r) == "table" then
			for k, v in pairs(r) do T.settings[k] = v end
		end
	end
end
T.loadSettings()

-- áp công tắc lưu kèm trong config (autoPlay giữ nguyên theo công tắc của bạn)
function T.applyCfgSettings(cfg)
	if type(cfg) ~= "table" or type(cfg.settings) ~= "table" then return end
	for _, k in ipairs({ "autoStart", "autoReplay", "autoSkip" }) do
		if type(cfg.settings[k]) == "boolean" then T.settings[k] = cfg.settings[k] end
	end
	T.saveSettings()
	for _, p in pairs(T.paints) do pcall(p) end
end

-- ================= REMOTE =================
function T.invoke(name, ...)
	local r = C2S and C2S:FindFirstChild(name)
	if not r then return false, nil end
	local args = table.pack(...)
	local ok, res = pcall(function() return r:InvokeServer(table.unpack(args, 1, args.n)) end)
	return ok, res
end

function T.onEvent(name, fn)
	local e = S2C and S2C:FindFirstChild(name)
	if e then table.insert(T.conns, e.OnClientEvent:Connect(fn)) end
end

-- ================= HELPER UNIT / WAVE =================
function T.pivotPos(i)
	local ok, cf = pcall(function() return i:GetPivot() end)
	if ok then return cf.Position end
	return nil
end

function T.flat(a, b)
	return (Vector3.new(a.X, 0, a.Z) - Vector3.new(b.X, 0, b.Z)).Magnitude
end

function T.mappedSet(map)
	local s = {}
	for _, v in pairs(map or T.slots) do
		if typeof(v) == "Instance" then s[v] = true
		elseif type(v) == "table" and v.inst then s[v.inst] = true end
	end
	return s
end

-- chụp danh sách unit hiện có (để biết unit nào MỚI sau khi đặt)
function T.snapshot()
	local s = {}
	local f = workspace:FindFirstChild("_UNITS")
	if f then
		for _, u in ipairs(f:GetChildren()) do s[u] = true end
	end
	return s
end

-- unit MỚI (không có trong snapshot) gần pos nhất -> không nhầm với titan đang đi qua
function T.findNewUnit(pos, before, nameFilter, timeout)
	local t0 = os.clock()
	repeat
		local f = workspace:FindFirstChild("_UNITS")
		if f then
			local best, bd
			for _, u in ipairs(f:GetChildren()) do
				if not before[u] and (not nameFilter or u.Name == nameFilter) then
					local p = T.pivotPos(u)
					if p then
						local d = T.flat(p, pos)
						if d < 15 and (not bd or d < bd) then best, bd = u, d end
					end
				end
			end
			if best then return best end
		end
		task.wait(0.1)
	until os.clock() - t0 >= (timeout or 4)
	return nil
end

-- unit ĐÃ có sẵn gần pos (dùng cho upgrade fallback / kiểm tra khi retry)
function T.findUnitAt(pos, nameFilter, exclude, timeout)
	local t0 = os.clock()
	repeat
		local f = workspace:FindFirstChild("_UNITS")
		if f then
			local best, bd
			for _, u in ipairs(f:GetChildren()) do
				if not exclude[u] and (not nameFilter or u.Name == nameFilter) then
					local p = T.pivotPos(u)
					if p then
						local d = T.flat(p, pos)
						if d < 15 and (not bd or d < bd) then best, bd = u, d end
					end
				end
			end
			if best then return best end
		end
		task.wait(0.15)
	until os.clock() - t0 >= (timeout or 4)
	return nil
end

function T.resetWave() T.wave = 1; T.waveStart = os.clock() end
function T.waveElapsed() return os.clock() - T.waveStart end

-- ================= WEBHOOK =================
local lastWebhookTime = 0
local function getStatsData()
	local stats = LocalPlayer:FindFirstChild("_stats")
	local gem, gold, xp = "N/A", "N/A", "N/A"
	if stats then
		if stats:FindFirstChild("gem_amount") then gem = tostring(stats.gem_amount.Value) end
		if stats:FindFirstChild("gold_amount") then gold = tostring(stats.gold_amount.Value) end
		if stats:FindFirstChild("player_xp") then xp = tostring(stats.player_xp.Value) end
	end
	local mapName = "Unknown"
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if pg then
		for _, v in ipairs(pg:GetDescendants()) do
			if v:IsA("TextLabel") and (string.lower(v.Name):find("map") or string.lower(v.Name):find("title")) and v.Text ~= "" then
				mapName = v.Text
				break
			end
		end
	end
	return mapName, gem, gold, xp
end

function T.sendWebhook(reason)
	local url = T.settings.webhook
	if not url or url == "" then return end
	if tick() - lastWebhookTime < 5 then return end
	lastWebhookTime = tick()
	local mapName, gem, gold, xp = getStatsData()
	local title = reason == "Load" and "🚀 **Script Loaded!**" or "🔄 **Retry Map Detected!**"
	local body = HttpService:JSONEncode({
		content = string.format("%s\n👤 **UID:** %d\n🗺️ **Map:** %s\n💎 **Gem:** %s\n💰 **Gold:** %s\n🌟 **XP/Level:** %s", title, LocalPlayer.UserId, mapName, gem, gold, xp),
	})
	task.spawn(function()
		local ok, err = pcall(function()
			local req = { Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body }
			if request then request(req)
			elseif syn and syn.request then syn.request(req)
			elseif http and http.request then http.request(req)
			else HttpService:PostAsync(url, body, Enum.HttpContentType.ApplicationJson) end
		end)
		if ok then print("✅ [Webhook] Gửi thành công (" .. reason .. ")") else print("❌ [Webhook] Lỗi:", err) end
	end)
end

-- ================= GHI MACRO =================
local function push(t, f)
	f.t = t
	f.w = T.wave
	f.dt = math.floor(T.waveElapsed() * 100) / 100
	table.insert(T.rec, f)
	return f
end

local function slotOf(inst)
	if typeof(inst) ~= "Instance" then return nil end
	for n, s in pairs(T.slots) do
		if s.inst == inst then return n end
	end
	local p = T.pivotPos(inst)
	if p then
		local bestSlot, minDist
		for n, s in pairs(T.slots) do
			if not s.inst then
				local d = T.flat(p, s.pos)
				if not minDist or d < minDist then minDist = d; bestSlot = n end
			end
		end
		if bestSlot and minDist < 15 then
			T.slots[bestSlot].inst = inst
			return bestSlot
		end
	end
	return nil
end

function T.startRec()
	if T.noHook then T.status("Executor không có hookmetamethod, không ghi được"); return end
	T.rec, T.slots, T.nextSlot = {}, {}, 1
	T.recording = true
	T.status("Đang ghi...")
end

function T.stopRec()
	T.recording = false
	T.status("Dừng ghi: " .. #T.rec .. " hành động")
end

-- hook gọi sau khi game gọi remote xong
function T.onCall(name, args, res, before)
	if name == "vote_start" then T.beginRound("vote_start"); return end
	if name == "set_game_finished_vote" then
		if args[1] == "replay" then T.sendWebhook("Retry") end
		return
	end
	if not T.recording or res[1] == false then return end

	if name == "spawn_unit" then
		local id, cf = args[1], args[2]
		if typeof(cf) ~= "CFrame" then return end
		local n = T.nextSlot
		T.nextSlot = n + 1
		T.slots[n] = { pos = cf.Position }
		local act = push("spawn", { slot = n, id = id, cf = { cf:GetComponents() } })
		local inst = (typeof(res[1]) == "Instance") and res[1] or T.findNewUnit(cf.Position, before or {}, nil, 4)
		if inst then
			T.slots[n].inst = inst
			act.name = inst.Name
		end
	elseif name == "upgrade_unit_ingame" then
		local inst = args[1]
		if typeof(inst) ~= "Instance" then return end
		local pos = T.pivotPos(inst)
		if not pos then return end
		local n = slotOf(inst)
		push("upgrade", { slot = n or -1, pos = { pos.X, pos.Y, pos.Z }, name = inst.Name })
	elseif name == "sell_unit_ingame" then
		local n = slotOf(args[1])
		if n then
			push("sell", { slot = n })
			T.slots[n] = nil
		end
	end
end

if hookmetamethod and newcclosure and checkcaller and getnamecallmethod then
	if not getgenv().Tuanh_HOOKED then
		getgenv().Tuanh_HOOKED = true
		local old
		old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
			local method = getnamecallmethod()
			local T_ = getgenv().TuanhMacro
			if method == "InvokeServer" and T_ and not T_.dead and not checkcaller() then
				local name = self.Name
				local watch = (name == "vote_start" or name == "set_game_finished_vote")
					or (T_.recording and (name == "spawn_unit" or name == "upgrade_unit_ingame" or name == "sell_unit_ingame"))
				if watch then
					local args = table.pack(...)
					local before = (name == "spawn_unit") and T_.snapshot() or nil
					if setnamecallmethod then setnamecallmethod(method) end
					local res = table.pack(old(self, ...))
					task.spawn(T_.onCall, name, args, res, before)
					return table.unpack(res, 1, res.n)
				end
			end
			if setnamecallmethod and method then setnamecallmethod(method) end
			return old(self, ...)
		end))
	end
else
	T.noHook = true
end

-- ================= PHÁT LẠI =================
local function runAction(a, slots, tries)
	if a.t == "spawn" then
		local cf = CFrame.new(table.unpack(a.cf))
		slots[a.slot] = { pos = cf.Position }
		if tries > 1 then -- lần trước có thể đã đặt được nhưng chưa thấy
			local ex = T.findUnitAt(cf.Position, a.name, T.mappedSet(slots), 0)
			if ex then slots[a.slot].inst = ex; return true end
		end
		local before = T.snapshot()
		local ok, res = T.invoke("spawn_unit", a.id, cf)
		if not ok or res == false then return false end
		local inst = (typeof(res) == "Instance") and res or T.findNewUnit(cf.Position, before, a.name, 4)
		if not inst then return false end
		slots[a.slot].inst = inst
		return true

	elseif a.t == "upgrade" then
		local s = (a.slot ~= -1) and slots[a.slot] or nil
		local inst = s and s.inst or nil
		if (not inst or not inst.Parent) and a.pos then
			inst = T.findUnitAt(Vector3.new(a.pos[1], a.pos[2], a.pos[3]), a.name, T.mappedSet(slots), 1)
		end
		if not inst or not inst.Parent then return true end
		task.wait(0.2)
		local ok, res = T.invoke("upgrade_unit_ingame", inst)
		return ok and res ~= false

	elseif a.t == "sell" then
		local s = slots[a.slot]
		local inst = s and s.inst or nil
		if not inst or not inst.Parent then return true end
		task.wait(0.2)
		local ok, res = T.invoke("sell_unit_ingame", inst)
		slots[a.slot] = nil
		return ok and res ~= false
	end
	return true
end

function T.stopPlay()
	if T.playing then T.status("Đã dừng macro") end
	T.playToken = T.playToken + 1
	T.playing = false
end

function T.play(cfg)
	if T.playing then return end
	if type(cfg) ~= "table" or type(cfg.actions) ~= "table" or #cfg.actions == 0 then
		T.status("Config rỗng/hỏng")
		return
	end
	T.playing = true
	T.playToken = T.playToken + 1
	local token = T.playToken
	local total = #cfg.actions

	task.spawn(function()
		local slots = {}
		for i, a in ipairs(cfg.actions) do
			while T.playToken == token and not (T.wave > a.w or (T.wave == a.w and T.waveElapsed() >= a.dt)) do
				task.wait(0.1)
			end
			local tries = 0
			while T.playToken == token do
				tries = tries + 1
				if runAction(a, slots, tries) then break end
				if tries >= 25 or T.wave > a.w + 2 then
					T.status(("Bỏ qua hành động %d/%d (thất bại nhiều lần)"):format(i, total))
					break
				end
				task.wait(1.2)
			end
			if T.playToken ~= token then return end
			T.status(("Chạy %d/%d (wave %d)"):format(i, total, T.wave))
			task.wait(0.1)
		end
		if T.playToken == token then
			T.playing = false
			T.status("Macro xong")
		end
	end)
end

-- ================= BẮT ĐẦU VÒNG MỚI =================
-- Gọi khi: game gọi vote_start (hook) / bảng Vote Start đóng lại / script vừa nạp.
-- Reset wave + chạy lại config đang chọn (nếu bật "Auto chạy config").
function T.beginRound(src)
	if T.dead then return end
	if tick() - T.lastBegin < 4 then return end -- chống gọi trùng
	T.lastBegin = tick()
	T.finished = false
	T.replayed = false
	T.resetWave()
	if T.recording then return end -- đang ghi thì không tự chạy macro
	T.stopPlay()
	if T.settings.autoPlay and T.settings.selected ~= "" then
		local cfg = T.loadConfig(T.settings.selected)
		if cfg then
			T.status("Vòng mới (" .. tostring(src) .. "): chạy " .. T.settings.selected)
			T.play(cfg)
		else
			T.status("Không đọc được config đã chọn")
		end
	end
end

-- ================= AUTO / SỰ KIỆN =================
local GuiService = game:GetService("GuiService")
local VIM = game:GetService("VirtualInputManager")
local function clickGui(g)
	local pos = g.AbsolutePosition + (g.AbsoluteSize / 2)
	local inset = GuiService:GetGuiInset()
	pcall(function()
		VIM:SendMouseMoveEvent(pos.X + inset.X, pos.Y + inset.Y, game)
		task.wait(0.03)
		VIM:SendMouseButtonEvent(pos.X + inset.X, pos.Y + inset.Y, 0, true, game, 1)
		task.wait(0.03)
		VIM:SendMouseButtonEvent(pos.X + inset.X, pos.Y + inset.Y, 0, false, game, 1)
	end)
end

-- nút có thực sự đang hiện không (cha ẩn / ScreenGui tắt cũng tính là ẩn)
local function isShown(g)
	local p = g
	while p and p:IsA("GuiBase2d") do
		if p:IsA("GuiObject") and not p.Visible then return false end
		if p:IsA("LayerCollector") and not p.Enabled then return false end
		p = p.Parent
	end
	return true
end

local function markReplayed()
	T.replayed = true
	T.replayedAt = tick()
	T.sendWebhook("Retry")
end

