T.onEvent("replay_started", function()
	T.finished = false
	T.replayed = false
	T.stopPlay()
	T.resetWave()
	T.status("Replay bắt đầu, chờ vote Start...")
end)

T.onEvent("start_vote_wave_skip", function()
	if T.settings.autoSkip and not T.dead then
		task.delay(0.3, function() T.invoke("vote_wave_skip") end)
	end
end)

T.onEvent("game_finished", function()
	T.stopPlay()
	T.finished = true
	T.replayed = false
	if T.settings.autoReplay and not T.dead then
		T.status("Game kết thúc, chờ bấm Replay...")
		-- dự phòng: nếu vòng lặp không bấm được nút thì vote bằng remote
		task.delay(3, function()
			if not T.dead and T.finished and not T.replayed and T.settings.autoReplay then
				T.invoke("set_game_finished_vote", "replay")
				markReplayed()
			end
		end)
	end
end)

-- ================= VÒNG LẶP TỰ ĐỘNG BẤM NÚT =================
local voteClickStart = 0
local voteWasVisible = false

task.spawn(function()
	while task.wait(0.25) do
		if T.dead then break end
		local pg = LocalPlayer:FindFirstChild("PlayerGui")
		if pg then
			-- ---- bảng Vote Start ----
			local vs = pg:FindFirstChild("VoteStart")
			local holder = vs and vs:FindFirstChild("Holder")
			local bh = holder and holder:FindFirstChild("ButtonHolder")
			local yes = bh and bh:FindFirstChild("Yes")
			local yesShown = yes and yes:IsA("TextButton") and yes.AbsoluteSize.X > 5 and isShown(yes)

			if yesShown then
				-- bảng Vote hiện = vòng mới đang chờ bắt đầu
				voteWasVisible = true
				T.finished = false
				T.replayed = false
				if voteClickStart == 0 then voteClickStart = tick() end
				if T.settings.autoStart and tick() - voteClickStart <= 30 then
					clickGui(yes)
				end
			else
				voteClickStart = 0
				if voteWasVisible then
					-- bảng Vote vừa đóng = ván bắt đầu (hook vote_start thường đã gọi trước, trùng sẽ bị bỏ qua)
					voteWasVisible = false
					task.delay(1, function() T.beginRound("vote-gui") end)
				end
			end

			-- ---- Auto Replay (chỉ quét khi game đã kết thúc, đỡ lag) ----
			if T.settings.autoReplay and T.finished then
				if T.replayed and tick() - T.replayedAt > 25 then T.replayed = false end -- bấm hụt thì thử lại
				if not T.replayed then
					for _, g in ipairs(pg:GetDescendants()) do
						if g:IsA("TextButton") and g.AbsoluteSize.X > 5 then
							local txt = string.lower(g.Text)
							if (txt:find("replay") or txt:find("play again")) and isShown(g) then
								print("🔥 [VIM] Tìm thấy nút Replay, đang bấm...")
								task.wait(0.2)
								clickGui(g)
								markReplayed()
								break
							end
						end
					end
				end
			end
		end
	end
end)

-- ================= KHI SCRIPT VỪA NẠP =================
task.spawn(function()
	local t0 = os.clock()
	while not workspace:FindFirstChild("_UNITS") and os.clock() - t0 < 30 do task.wait(0.5) end
	if not workspace:FindFirstChild("_UNITS") then return end
	task.wait(3)
	if T.dead then return end
	if voteWasVisible then return end -- đang có bảng Vote: vòng lặp bên trên lo
	if T.settings.autoStart then T.invoke("vote_start") end
	T.beginRound("init")
end)

