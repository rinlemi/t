-- chọn config
local list, idx = {}, 0
local cfgRow = row(30)
local nameLbl = mk("TextLabel", {
	Size = UDim2.new(0.6, 0, 1, 0), Position = UDim2.new(0.2, 0, 0, 0), BackgroundColor3 = FIELD,
	TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.SourceSansBold, TextSize = 15, Text = "",
	TextTruncate = Enum.TextTruncate.AtEnd,
}, cfgRow)
mk("UICorner", { CornerRadius = UDim.new(0, 6) }, nameLbl)

local function refresh()
	list = T.listConfigs()
	idx = 0
	for i, n in ipairs(list) do
		if n == T.settings.selected then idx = i end
	end
	if idx == 0 and #list > 0 then idx = 1; T.settings.selected = list[1] end
	if #list == 0 then T.settings.selected = "" end
	nameLbl.Text = (T.settings.selected ~= "") and T.settings.selected or "(chưa có config)"
end

local function pick(d)
	if #list == 0 then return end
	idx = ((idx - 1 + d) % #list) + 1
	T.settings.selected = list[idx]
	T.saveSettings()
	refresh()
end

local prev = btn(cfgRow, "<", 1, 1, function() pick(-1) end)
prev.Size = UDim2.new(0.2, -4, 1, 0)
local nxt = btn(cfgRow, ">", 1, 1, function() pick(1) end)
nxt.Size = UDim2.new(0.2, -4, 1, 0)
nxt.Position = UDim2.new(0.8, 4, 0, 0)

local box = field("Tên config mới (vd: map1)", "", 15)

-- ghi / lưu
local r1 = row(32)
btn(r1, "Ghi", 1, 3, function() T.startRec() end)
btn(r1, "Dừng ghi", 2, 3, function() T.stopRec() end)
btn(r1, "Lưu", 3, 3, function()
	if T.recording then T.stopRec() end
	if #T.rec == 0 then T.status("Chưa ghi gì"); return end
	local name = box.Text
	if T.cleanName(name) == "" then name = "macro_" .. os.date("%H%M%S") end
	local saveData = {
		version = 1, created = os.time(), actions = T.rec,
		settings = { autoStart = T.settings.autoStart, autoReplay = T.settings.autoReplay, autoSkip = T.settings.autoSkip },
	}
	local ok, saved = T.saveConfig(name, saveData)
	if ok then
		T.settings.selected = saved
		T.saveSettings()
		box.Text = ""
		refresh()
		T.status("Đã lưu: " .. saved .. " (" .. #T.rec .. " hành động)")
	else
		T.status("Lưu lỗi")
	end
end)

-- chạy / dừng / xóa
local r2 = row(32)
btn(r2, "Chạy", 1, 3, function()
	local cfg = (T.settings.selected ~= "") and T.loadConfig(T.settings.selected) or nil
	if not cfg then T.status("Chưa chọn config"); return end
	T.applyCfgSettings(cfg)
	T.play(cfg)
end)
btn(r2, "Dừng", 2, 3, function() T.stopPlay() end)
btn(r2, "Xóa", 3, 3, function()
	if T.settings.selected == "" then return end
	T.deleteConfig(T.settings.selected)
	T.status("Đã xóa: " .. T.settings.selected)
	T.settings.selected = ""
	T.saveSettings()
	refresh()
end)

-- công tắc
local function toggle(label, key)
	local b
	local function paint()
		b.Text = label .. ": " .. (T.settings[key] and "BẬT" or "TẮT")
		b.BackgroundColor3 = T.settings[key] and ON or OFF
	end
	b = btn(row(28), label, 1, 1, function()
		T.settings[key] = not T.settings[key]
		T.saveSettings()
		paint()
	end)
	T.paints[key] = paint
	paint()
end
toggle("Auto Start", "autoStart")
toggle("Auto Replay", "autoReplay")
toggle("Auto Skip Wave", "autoSkip")
toggle("Auto chạy config", "autoPlay")

refresh()

task.delay(3, function()
	if not T.dead then T.sendWebhook("Load") end
end)

