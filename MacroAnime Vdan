-- ================= FILE SYSTEM =================
function T.cleanName(n) return tostring(n or ""):gsub('[\\/:*?"<>|]', ""):gsub("^%s+", ""):gsub("%s+$", "") end
function T.listConfigs() local out = {} local ok, files = pcall(listfiles, CFG) if ok and type(files) == "table" then for _, f in ipairs(files) do local n = tostring(f):match("([^/\\]+)%.json$") if n then table.insert(out, n) end end end table.sort(out) return out end
function T.saveConfig(name, data) name = T.cleanName(name) if name == "" then return false end return pcall(writefile, CFG .. "/" .. name .. ".json", HttpService:JSONEncode(data)), name end
function T.loadConfig(name) local p = CFG .. "/" .. tostring(name) .. ".json" if not isfile(p) then return nil end local ok, r = pcall(function() return HttpService:JSONDecode(readfile(p)) end) if ok then return r end return nil end
function T.deleteConfig(name) if delfile then pcall(delfile, CFG .. "/" .. tostring(name) .. ".json") end end
function T.saveSettings() pcall(writefile, ROOT .. "/settings.json", HttpService:JSONEncode(T.settings)) end
function T.loadSettings() if isfile(ROOT .. "/settings.json") then local ok, r = pcall(function() return HttpService:JSONDecode(readfile(ROOT .. "/settings.json")) end) if ok and type(r) == "table" then for k, v in pairs(r) do T.settings[k] = v end end end end
T.loadSettings()

-- ================= REMOTE INVOKE =================
function T.invoke(name, ...) local r = C2S and C2S:FindFirstChild(name) if not r then return false, nil end local args = table.pack(...) local ok, res = pcall(function() return r:InvokeServer(table.unpack(args, 1, args.n)) end) return ok, res end
function T.onEvent(name, fn) local e = S2C and S2C:FindFirstChild(name) if e then table.insert(T.conns, e.OnClientEvent:Connect(fn)) end end

-- ================= HELPER =================
function T.pivotPos(i) local ok, cf = pcall(function() return i:GetPivot() end) if ok then return cf.Position end return nil end
function T.flat(a, b) return (Vector3.new(a.X, 0, a.Z) - Vector3.new(b.X, 0, b.Z)).Magnitude end
function T.mappedSet(map) local s = {} for _, v in pairs(map or T.slots) do if typeof(v) == "Instance" then s[v] = true elseif type(v) == "table" and v.inst then s[v.inst] = true end end return s end

function T.findUnitAt(pos, nameFilter, exclude, timeout) 
    local t0 = os.clock() 
    repeat 
        local f = workspace:FindFirstChild("_UNITS") 
        if f then 
            local closestUnit = nil
            local minDist = 999
            for _, u in ipairs(f:GetChildren()) do 
                if not exclude[u] then 
                    local isNameMatch = true
                    if nameFilter and u.Name ~= nameFilter then isNameMatch = false end
                    
                    if isNameMatch then
                        local p = T.pivotPos(u) 
                        if p then
                            local d = T.flat(p, pos)
                            if d < minDist and d < 15 then 
                                minDist = d
                                closestUnit = u
                            end
                        end
                    end
                end 
            end 
            if closestUnit then return closestUnit end
        end 
        task.wait(0.15) 
    until os.clock() - t0 >= (timeout or 4) 
    return nil 
end

function T.resetWave() T.wave = 1; T.waveStart = os.clock() end
function T.waveElapsed() return os.clock() - T.waveStart end

-- ================= WEBHOOK =================
local lastWebhookTime = 0
local function getStatsData()
    local stats = LocalPlayer:FindFirstChild("_stats")
    local gem, gold, xp = "N/A", "N/A", "N/A"
    if stats then
        if stats:FindFirstChild("gem_amount") then gem = tostring(stats.gem_amount.Value) end
        if stats:FindFirstChild("gold_amount") then gold = tostring(stats.gold_amount.Value) end
        if stats:FindFirstChild("player_xp") then xp = tostring(stats.player_xp.Value) end
    end
    local mapName = "Unknown"
    local mapGui = LocalPlayer:FindFirstChild("PlayerGui")
    if mapGui then
        for _, v in ipairs(mapGui:GetDescendants()) do
            if v:IsA("TextLabel") and (string.lower(v.Name):find("map") or string.lower(v.Name):find("title")) and v.Text ~= "" then
                mapName = v.Text
                break
            end
        end
    end
    return mapName, gem, gold, xp
end

local function sendWebhook(reason)
    local url = T.settings.webhook
    if not url or url == "" then return end
    if tick() - lastWebhookTime < 5 then return end
    lastWebhookTime = tick()
    
    local mapName, gem, gold, xp = getStatsData()
    local title = reason == "Load" and "🚀 **Script Loaded!**" or "🔄 **Retry Map Detected!**"
    local body = HttpService:JSONEncode({
        content = string.format("%s\n👤 **UID:** %d\n🗺️ **Map:** %s\n💎 **Gem:** %s\n💰 **Gold:** %s\n🌟 **XP/Level:** %s", title, LocalPlayer.UserId, mapName, gem, gold, xp)
    })
    
    task.spawn(function()
        local ok, err = pcall(function()
            if request then request({Url = url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = body})
            elseif syn and syn.request then syn.request({Url = url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = body})
            elseif http and http.request then http.request({Url = url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = body})
            else HttpService:PostAsync(url, body, Enum.HttpContentType.ApplicationJson) end
        end)
        if ok then print("✅ [Webhook] Gửi thành công ("..reason..")!") else print("❌ [Webhook] Lỗi:", err) end
    end)
end

-- ================= GHI MACRO =================
local function push(t, f) f.t = t; f.w = T.wave; f.dt = math.floor(T.waveElapsed() * 100) / 100; table.insert(T.rec, f) end
local function slotOf(inst) 
    if typeof(inst) ~= "Instance" then return nil end 
    for n, s in pairs(T.slots) do if s.inst == inst then return n end end 
    local p = T.pivotPos(inst) 
    if p then 
        local bestSlot, minDist
        for n, s in pairs(T.slots) do 
            if not s.inst then 
                local d = T.flat(p, s.pos)
                if not minDist or d < minDist then minDist = d bestSlot = n end
            end 
        end 
        if bestSlot and minDist < 15 then T.slots[bestSlot].inst = inst return bestSlot end
    end 
    return nil 
end

function T.startRec() T.rec, T.slots, T.nextSlot = {}, {}, 1 T.recording = true T.status("Đang ghi...") end
function T.stopRec() T.recording = false T.status("Dừng ghi: " .. #T.rec .. " hành động") end

function T.onCall(name, args, res)
    if name == "vote_start" then T.resetWave(); return end
    
    if name == "set_game_finished_vote" then
        if args[1] == "replay" then sendWebhook("Retry") end
    end

    if not T.recording or res[1] == false then return end

    if name == "spawn_unit" then
        local id, cf = args[1], args[2]
        if typeof(cf) ~= "CFrame" then return end
        local n = T.nextSlot; T.nextSlot = n + 1; T.slots[n] = { pos = cf.Position }
        push("spawn", { slot = n, id = id, cf = { cf:GetComponents() } })
        local inst = (typeof(res[1]) == "Instance") and res[1] or T.findUnitAt(cf.Position, nil, T.mappedSet(), 4)
        if inst then T.slots[n].inst = inst T.slots[n].name = inst.Name end
    elseif name == "upgrade_unit_ingame" then
        local inst = args[1]
        local n = slotOf(inst)
        local pos = T.pivotPos(inst)
        if n then push("upgrade", { slot = n, pos = {pos.X, pos.Y, pos.Z}, name = inst.Name })
        else push("upgrade", { slot = -1, pos = {pos.X, pos.Y, pos.Z}, name = inst.Name }) end
    elseif name == "sell_unit_ingame" then
        local n = slotOf(args[1])
        if n then push("sell", { slot = n }) T.slots[n] = nil end
    end
end

if hookmetamethod and newcclosure and checkcaller and getnamecallmethod then
    if not getgenv().Tuanh_HOOKED then
        getgenv().Tuanh_HOOKED = true
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local T_ = getgenv().TuanhMacro
            if method == "InvokeServer" and T_ and not T_.dead and not checkcaller() then
                local name = self.Name
                if name == "vote_start" or name == "set_game_finished_vote" or (T_.recording and (name == "spawn_unit" or name == "upgrade_unit_ingame" or name == "sell_unit_ingame")) then
                    local args = table.pack(...); if setnamecallmethod then setnamecallmethod(method) end
                    local res = table.pack(old(self, ...)); task.spawn(T_.onCall, name, args, res); return table.unpack(res, 1, res.n)
                end
            end
            if setnamecallmethod and method then setnamecallmethod(method) end
            return old(self, ...)
        end))
    end
end

-- ================= PHÁT LẠI =================
local function runAction(a, slots, tries)
    if a.t == "spawn" then
        local cf = CFrame.new(table.unpack(a.cf))
        slots[a.slot] = { pos = cf.Position } 
        if tries > 1 then local ex = T.findUnitAt(cf.Position, nil, T.mappedSet(slots), 0) if ex then slots[a.slot].inst = ex; return true end end
        local ok, res = T.invoke("spawn_unit", a.id, cf); if not ok or res == false then return false end
        local inst = (typeof(res) == "Instance") and res or T.findUnitAt(cf.Position, nil, T.mappedSet(slots), 4)
        if not inst then return false end; slots[a.slot].inst = inst; return true
    elseif a.t == "upgrade" then
        local inst = nil
        if a.slot ~= -1 and slots[a.slot] then inst = slots[a.slot].inst or slots[a.slot] end
        if (not inst or not inst.Parent) and a.pos then
            local targetPos = Vector3.new(a.pos[1], a.pos[2], a.pos[3])
            inst = T.findUnitAt(targetPos, a.name, T.mappedSet(slots), 1)
        end
        if not inst or not inst.Parent then return true end
        task.wait(0.2); local ok, res = T.invoke("upgrade_unit_ingame", inst); return ok and res ~= false
    elseif a.t == "sell" then
        local inst = nil
        if a.slot ~= -1 and slots[a.slot] then inst = slots[a.slot].inst or slots[a.slot] end
        if not inst or not inst.Parent then return true end
        task.wait(0.2); local ok, res = T.invoke("sell_unit_ingame", inst); if a.slot ~= -1 then slots[a.slot] = nil end; return ok and res ~= false
    end
    return true
end

function T.stopPlay() if T.playing then T.status("Đã dừng") end T.playToken = T.playToken + 1; T.playing = false end

function T.play(cfg)
    if T.playing then return end
    if type(cfg) ~= "table" or type(cfg.actions) ~= "table" or #cfg.actions == 0 then return end
    T.playing = true; T.playToken = T.playToken + 1
    local token = T.playToken; local total = #cfg.actions
    task.spawn(function()
        local slots = {}
        for i, a in ipairs(cfg.actions) do
            while T.playToken == token and not (T.wave > a.w or (T.wave == a.w and T.waveElapsed() >= a.dt)) do task.wait(0.1) end
            local tries = 0
            while T.playToken == token do
                tries = tries + 1
                if runAction(a, slots, tries) then break end
                if tries >= 25 or T.wave > a.w + 2 then break end
                task.wait(1.2)
            end
            if T.playToken ~= token then return end
            task.wait(0.1)
        end
        if T.playToken == token then T.playing = false; T.status("Macro xong") end
    end)
end

