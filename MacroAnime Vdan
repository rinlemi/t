local replayed = false

task.spawn(function()
    while task.wait(0.2) do
        if T.dead then break end
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        
        -- AUTO VOTE YES (Spam click liên tục đến khi mất bảng)
        if T.settings.autoStart then
            local voteStart = pg and pg:FindFirstChild("VoteStart")
            if voteStart then
                local holder = voteStart:FindFirstChild("Holder")
                local btnHolder = holder and holder:FindFirstChild("ButtonHolder")
                local yesBtn = btnHolder and btnHolder:FindFirstChild("Yes")
                
                -- Chỉ cần nút tồn tại và đang hiển thị là spam click liên tục
                if yesBtn and yesBtn:IsA("TextButton") and yesBtn.Visible then
                    -- Lấy tọa độ mới nhất (vì UI có thể đang trượt)
                    local pos = yesBtn.AbsolutePosition + (yesBtn.AbsoluteSize / 2)
                    local inset = GuiService:GetGuiInset()
                    
                    pcall(function()
                        VIM:SendMouseMoveEvent(pos.X + inset.X, pos.Y + inset.Y, game)
                        task.wait(0.02)
                        VIM:SendMouseButtonEvent(pos.X + inset.X, pos.Y + inset.Y, 0, true, game, 1)
                        task.wait(0.02)
                        VIM:SendMouseButtonEvent(pos.X + inset.X, pos.Y + inset.Y, 0, false, game, 1)
                    end)
                end
            end
        end
        
        -- AUTO REPLAY
        if T.settings.autoReplay then
            for _, gui in ipairs(pg:GetDescendants()) do
                if gui:IsA("TextButton") and (string.lower(gui.Text):find("replay") or string.lower(gui.Text):find("play again")) then
                    local isVisible = true
                    local p = gui
                    while p and p ~= pg do
                        if p:IsA("GuiObject") and not p.Visible then isVisible = false; break end
                        p = p.Parent
                    end
                    if isVisible and not replayed and gui.AbsoluteSize.X > 5 then
                        print("🔥 [VIM] Tìm thấy nút Replay, đang bấm...")
                        task.wait(0.2)
                        local pos = gui.AbsolutePosition + (gui.AbsoluteSize / 2)
                        local inset = GuiService:GetGuiInset()
                        pcall(function()
                            VIM:SendMouseMoveEvent(pos.X + inset.X, pos.Y + inset.Y, game)
                            task.wait(0.05)
                            VIM:SendMouseButtonEvent(pos.X + inset.X, pos.Y + inset.Y, 0, true, game, 1)
                            task.wait(0.05)
                            VIM:SendMouseButtonEvent(pos.X + inset.X, pos.Y + inset.Y, 0, false, game, 1)
                        end)
                        replayed = true
                        sendWebhook("Retry") 
                        break
                    end
                end
            end
        end
        if not workspace:FindFirstChild("_UNITS") then replayed = false end
    end
end)

T.onEvent("game_finished", function()
    T.stopPlay()
    if T.settings.autoReplay and not T.dead then
        task.delay(2, function() if not T.dead and not replayed then T.invoke("set_game_finished_vote", "replay") end end)
    end
end)

-- AUTO START BAN ĐẦU
task.spawn(function()
    local t0 = os.clock()
    while not workspace:FindFirstChild("_UNITS") and os.clock() - t0 < 30 do task.wait(0.5) end
    if not workspace:FindFirstChild("_UNITS") then return end
    task.wait(2)
    if T.dead then return end
    if T.settings.autoStart then T.invoke("vote_start"); T.resetWave(); T.status("Auto Start") end
    if T.settings.autoPlay and T.settings.selected ~= "" then
        local cfg = T.loadConfig(T.settings.selected)
        if cfg then T.play(cfg) end
    end
end)

