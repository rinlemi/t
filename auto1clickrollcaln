local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local LP = Players.LocalPlayer
if not LP then repeat task.wait(0.1); LP = Players.LocalPlayer until LP end
local PG = LP:WaitForChild("PlayerGui", 120)

local SF, SE
local _t = tick() + 120
while tick() < _t do
    local comm = RS:FindFirstChild("Communication")
    if comm then
        local sac = comm:FindFirstChild("ServerAndClient")
        if sac then
            local sig = sac:FindFirstChild("Signals")
            if sig then
                SF = sig:FindFirstChild("SignalFunction") and sig.SignalFunction:FindFirstChild("Function")
                SE = sig:FindFirstChild("SignalEvent") and sig.SignalEvent:FindFirstChild("Event")
                if SF and SE then break end
            end
        end
    end
    task.wait(0.2)
end

