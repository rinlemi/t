local function getSlot()
    local data = RS:FindFirstChild("Player_Service")
        and RS.Player_Service:FindFirstChild("Data")
        and RS.Player_Service.Data:FindFirstChild(LP.Name)
    if not data then return nil end
    local equipped = data.slotEquipped and data.slotEquipped.Value or 1
    return data.slots and data.slots["Slot" .. equipped]
end

local function getClan()
    local s = getSlot()
    return s and s.Clan and s.Clan.Value or nil
end

local function getSpins()
    local s = getSlot()
    return s and s.Spinning and s.Spinning.Spins and s.Spinning.Spins.Value or 0
end

local function isSupreme(name)
    return SUPREME_CLANS[name] == true
end

-- ⭐ CHỜ CHARACTER (đã vào game thật)
local function waitForCharacter(timeout)
    timeout = timeout or 300
    local t = tick() + timeout
    
    if LP.Character and LP.Character:FindFirstChild("Humanoid") then
        return true
    end
    
    while tick() < t do
        if LP.Character and LP.Character:FindFirstChild("Humanoid") then
            return true
        end
        task.wait(0.5)
    end
    return false
end

-- ⭐ CHỜ CUSTOMIZE BUTTON
local function waitForCustomizeButton(timeout)
    timeout = timeout or 60
    local t = tick() + timeout
    while tick() < t do
        local components = PG:FindFirstChild("Components")
        local menu = components and components:FindFirstChild("Menu")
        local holder = menu and menu:FindFirstChild("OptionsHolder")
        local presenter = holder and holder:FindFirstChild("2-CUSTOMIZE-Presenter")
        local btn = presenter and presenter:FindFirstChild("Button")
        if btn then return btn end
        task.wait(0.3)
    end
    return nil
end

-- ⭐ CLICK BUTTON 3 CÁCH
local function clickButton(btn)
    if not btn then return false end
    
    pcall(function() btn:Activate() end)
    
    if firesignal then
        pcall(function() firesignal(btn.MouseButton1Click) end)
        pcall(function() firesignal(btn.Activated) end)
    end
    
    pcall(function()
        local VIM = game:GetService("VirtualInputManager")
        local pos = btn.AbsolutePosition + (btn.AbsoluteSize / 2)
        VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
        task.wait(0.05)
        VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
    end)
    
    return true
end

-- ═══════════════════════════════════════════════════════
-- AUTO ROLL
-- ═══════════════════════════════════════════════════════

local isRolling = false

local function autoRoll()
    isRolling = true
    local count = 0

    log("🚀 Bắt đầu auto roll", Color3.fromRGB(255, 100, 200))

    while isRolling do
        local spins = getSpins()
        SpinsLbl.Text = "Spins: " .. spins

        if spins <= 0 then
            Status.Text = "❌ Hết spins"
            Status.TextColor3 = Color3.fromRGB(255,100,100)
            log("❌ Hết spins sau " .. count .. " lần", Color3.fromRGB(255, 100, 100))
            break
        end

        Status.Text = "🔄 Đang quay..."
        Status.TextColor3 = Color3.fromRGB(255,220,100)

        local clanBefore = getClan()
        local spinsBefore = getSpins()

        local ok = pcall(function() SF:InvokeServer("ClanSpin") end)
        if not ok then
            log("❌ Lỗi ClanSpin", Color3.fromRGB(255, 80, 80))
            break
        end

        task.wait(ROLL_DELAY)
        pcall(function() SE:FireServer("ClanSpinComplete") end)

        local timeout = tick() + 5
        while tick() < timeout do
            task.wait(0.05)
            if getClan() ~= clanBefore and getSpins() < spinsBefore then
                break
            end
        end

        count = count + 1
        RollsLbl.Text = "Quay: " .. count

        local clan = getClan()
        local newSpins = getSpins()
        ClanLbl.Text = "Clan: " .. (clan or "---")
        SpinsLbl.Text = "Spins: " .. newSpins

        if clan and clan ~= clanBefore then
            log("#" .. count .. ": " .. clan, Color3.fromRGB(150, 200, 255))
        end

        if clan and isSupreme(clan) then
            Status.Text = "🎉 SUPREME: " .. clan
            Status.TextColor3 = Color3.fromRGB(255, 215, 0)
            ClanLbl.TextColor3 = Color3.fromRGB(255, 215, 0)
            log("🎉🎉 SUPREME: " .. clan, Color3.fromRGB(255, 215, 0))
            pcall(function()
                StarterGui:SetCore("SendNotification", {
                    Title = "🎉 SUPREME FOUND!",
                    Text = clan .. " sau " .. count .. " lần",
                    Duration = 10,
                })
            end)
            break
        end

        task.wait(0.3)
    end

    isRolling = false
    StartBtn.Text = "▶️ BẮT ĐẦU"
    StartBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 180)
end

