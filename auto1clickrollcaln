-- SEQUENCE TỰ ĐỘNG
-- ═══════════════════════════════════════════════════════

local function runAutoSequence()
    -- ⭐ 1. CHỜ CHARACTER
    Status.Text = "⏳ Chờ vào game..."
    log("⏳ Chờ character (max 5 phút)...", Color3.fromRGB(200, 200, 200))
    
    if not waitForCharacter(300) then
        log("❌ Timeout chờ character", Color3.fromRGB(255, 100, 100))
        return
    end
    
    log("✅ Đã vào game!", Color3.fromRGB(100, 255, 100))
    Status.Text = "⏳ Đợi 3s cho game ổn định..."
    task.wait(3)

    -- ⭐ 2. CHỜ DATA
    Status.Text = "⏳ Chờ data..."
    log("⏳ Chờ data load...", Color3.fromRGB(200, 200, 200))
    
    local t = tick() + 60
    while tick() < t do
        local ps = RS:FindFirstChild("Player_Service")
        if ps then
            local data = ps:FindFirstChild("Data")
            if data then
                local me = data:FindFirstChild(LP.Name)
                if me and me:FindFirstChild("slots") then
                    break
                end
            end
        end
        task.wait(0.5)
    end
    log("✅ Data loaded", Color3.fromRGB(100, 255, 100))

    -- ⭐ 3. CODE 1
    Status.Text = "📝 Nhập code 1..."
    log("📝 Code 1: " .. CODE_1, Color3.fromRGB(100, 200, 255))
    pcall(function() SF:InvokeServer("RedeemCode", CODE_1) end)
    log("⏳ Đợi " .. STEP_DELAY .. "s...", Color3.fromRGB(200, 200, 200))
    task.wait(STEP_DELAY)

    -- ⭐ 4. CODE 2
    Status.Text = "📝 Nhập code 2..."
    log("📝 Code 2: " .. CODE_2, Color3.fromRGB(100, 200, 255))
    pcall(function() SF:InvokeServer("RedeemCode", CODE_2) end)
    log("⏳ Đợi " .. STEP_DELAY .. "s cho popup đóng...", Color3.fromRGB(200, 200, 200))
    task.wait(STEP_DELAY)

    -- ⭐ 5. CUSTOMIZE
    Status.Text = "🎨 Chờ Customize..."
    log("🎨 Tìm Customize button...", Color3.fromRGB(200, 100, 255))
    
    local btn = waitForCustomizeButton(60)
    
    if btn then
        log("✅ Tìm thấy Customize", Color3.fromRGB(100, 255, 100))
        log("   Visible: " .. tostring(btn.Visible), Color3.fromRGB(200, 200, 200))
        log("   Active: " .. tostring(btn.Active), Color3.fromRGB(200, 200, 200))
        clickButton(btn)
        log("✅ Đã click Customize", Color3.fromRGB(100, 255, 100))
    else
        log("❌ Không tìm thấy Customize sau 60s", Color3.fromRGB(255, 100, 100))
    end
    
    log("⏳ Đợi menu mở (2s)...", Color3.fromRGB(200, 200, 200))
    task.wait(2)

    -- ⭐ 6. AUTO ROLL
    Status.Text = "🚀 Bắt đầu auto roll..."
    log("🚀 Auto roll Supreme", Color3.fromRGB(255, 100, 200))
    StartBtn.Text = "⏹️ DỪNG"
    StartBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
    task.spawn(autoRoll)
end

-- ⭐ CHẠY AUTO SEQUENCE
task.spawn(runAutoSequence)

