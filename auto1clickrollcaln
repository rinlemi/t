-- HELPERS
-- ═══════════════════════════════════════════════════════

local function getSlot()
    local data = RS:FindFirstChild("Player_Service")
        and RS.Player_Service:FindFirstChild("Data")
        and RS.Player_Service.Data:FindFirstChild(LP.Name)
    if not data then return nil end
    local equipped = data.slotEquipped and data.slotEquipped.Value or 1
    return data.slots and data.slots["Slot" .. equipped]
end

local function getClan()
    local s = getSlot()
    return s and s.Clan and s.Clan.Value or nil
end

local function getSpins()
    local s = getSlot()
    return s and s.Spinning and s.Spinning.Spins and s.Spinning.Spins.Value or 0
end

local function isTarget(name)
    return TARGET_CLANS[name] == true
end

local function waitForCharacter(timeout)
    timeout = timeout or 300
    local t = tick() + timeout
    if LP.Character and LP.Character:FindFirstChild("Humanoid") then return true end
    while tick() < t do
        if LP.Character and LP.Character:FindFirstChild("Humanoid") then return true end
        task.wait(0.5)
    end
    return false
end

local function waitForCustomizeButton(timeout)
    timeout = timeout or 60
    local t = tick() + timeout
    while tick() < t do
        local components = PG:FindFirstChild("Components")
        local menu = components and components:FindFirstChild("Menu")
        local holder = menu and menu:FindFirstChild("OptionsHolder")
        local presenter = holder and holder:FindFirstChild("2-CUSTOMIZE-Presenter")
        local btn = presenter and presenter:FindFirstChild("Button")
        if btn then return btn end
        task.wait(0.3)
    end
    return nil
end

local function clickButton(btn)
    if not btn then return false end
    pcall(function() btn:Activate() end)
    if firesignal then
        pcall(function() firesignal(btn.MouseButton1Click) end)
        pcall(function() firesignal(btn.Activated) end)
    end
    return true
end

-- ═══════════════════════════════════════════════════════
-- AUTO ROLL — FAST + SAFE
-- ═══════════════════════════════════════════════════════

local isRolling = false

local function autoRoll()
    isRolling = true
    local count = 0
    local gotTarget = false
    local targetClan = nil
    
    log("🚀 Roll 0.6s — check TRƯỚC khi roll", Color3.fromRGB(255, 100, 200))

    while isRolling do
        -- ⭐ BƯỚC 1: CHECK CLAN HIỆN TẠI TRƯỚC
        local currentClan = getClan()
        
        if currentClan and isTarget(currentClan) then
            gotTarget = true
            targetClan = currentClan
            log("🛑 SUPREME: " .. currentClan .. " — DỪNG!", Color3.fromRGB(255, 215, 0))
            break
        end
        
        local spins = getSpins()
        SpinsLbl.Text = "Spins: " .. spins

        if spins <= 0 then
            Status.Text = "❌ Hết spins"
            Status.TextColor3 = Color3.fromRGB(255,100,100)
            log("❌ Hết spins sau " .. count .. " roll", Color3.fromRGB(255, 100, 100))
            break
        end

        Status.Text = "🔄 Đang quay..."
        Status.TextColor3 = Color3.fromRGB(255,220,100)

        local spinsBefore = getSpins()

        -- ⭐ BƯỚC 2: GỬI ROLL
        local ok = pcall(function() SF:InvokeServer("ClanSpin") end)
        if not ok then break end

        for i = 1, 5 do
            task.wait(0.02)
            pcall(function() SE:FireServer("ClanSpinComplete") end)
        end

        -- Đợi spins giảm (poll nhanh)
        local t = tick()
        while tick() - t < 3 do
            task.wait(0.02)
            if getSpins() < spinsBefore then break end
        end
        
        -- ⭐ ĐỢI CLAN UPDATE
        task.wait(CLAN_UPDATE_WAIT)

        -- ⭐ BƯỚC 3: ĐỌC CLAN + LOG
        local newClan = getClan()
        
        count = count + 1
        RollsLbl.Text = "Quay: " .. count
        ClanLbl.Text = "Clan: " .. (newClan or "---")
        SpinsLbl.Text = "Spins: " .. getSpins()
        
        if newClan then
            local color = Color3.fromRGB(150, 200, 255)
            local prefix = "#" .. count .. ": "
            
            if isTarget(newClan) then
                color = Color3.fromRGB(255, 215, 0)
                prefix = "⭐ #" .. count .. ": "
            end
            
            log(prefix .. newClan, color)
        end

        task.wait(ROLL_DELAY)
    end

    -- BÁO KẾT QUẢ
    if gotTarget then
        local found = targetClan or getClan() or "???"
        Status.Text = "🎉 SUPREME: " .. found
        Status.TextColor3 = Color3.fromRGB(255, 215, 0)
        ClanLbl.TextColor3 = Color3.fromRGB(255, 215, 0)
        ClanLbl.Text = "Clan: " .. found
        log("═══════════════════════════", Color3.fromRGB(255, 215, 0))
        log("🎉🎉 SUPREME: " .. found, Color3.fromRGB(255, 215, 0))
        log("═══════════════════════════", Color3.fromRGB(255, 215, 0))
        
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "🎉 SUPREME FOUND!",
                Text = found .. " sau " .. count .. " lần",
                Duration = 30,
            })
        end)
    end

    isRolling = false
    StartBtn.Text = "▶️ BẮT ĐẦU"
    StartBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 180)
end

-- ═══════════════════════════════════════════════════════
-- SEQUENCE
-- ═══════════════════════════════════════════════════════

local function runAutoSequence()
    Status.Text = "⏳ Đợi " .. STARTUP_DELAY .. "s..."
    log("⏳ Đợi " .. STARTUP_DELAY .. "s...", Color3.fromRGB(200, 200, 200))
    task.wait(STARTUP_DELAY)
    
    Status.Text = "⏳ Chờ vào game..."
    if not waitForCharacter(300) then
        log("❌ Timeout character", Color3.fromRGB(255, 100, 100))
        return
    end
    
    log("✅ Đã vào game!", Color3.fromRGB(100, 255, 100))
    task.wait(3)

    local t = tick() + 60
    while tick() < t do
        local ps = RS:FindFirstChild("Player_Service")
        if ps and ps:FindFirstChild("Data") and ps.Data:FindFirstChild(LP.Name) then break end
        task.wait(0.5)
    end

    Status.Text = "📝 Nhập code 1..."
    log("📝 Code 1: " .. CODE_1, Color3.fromRGB(100, 200, 255))
    pcall(function() SF:InvokeServer("RedeemCode", CODE_1) end)
    task.wait(STEP_DELAY)

    Status.Text = "📝 Nhập code 2..."
    log("📝 Code 2: " .. CODE_2, Color3.fromRGB(100, 200, 255))
    pcall(function() SF:InvokeServer("RedeemCode", CODE_2) end)
    task.wait(STEP_DELAY)

    Status.Text = "🎨 Chờ Customize..."
    log("🎨 Tìm Customize...", Color3.fromRGB(200, 100, 255))
    local btn = waitForCustomizeButton(60)
    if btn then
        clickButton(btn)
        log("✅ Đã click Customize", Color3.fromRGB(100, 255, 100))
    end
    
    task.wait(2)

    Status.Text = "🚀 Auto roll..."
    StartBtn.Text = "⏹️ DỪNG"
    StartBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
    task.spawn(autoRoll)
end

task.spawn(runAutoSequence)

