local equipDrop

local function buildToolList()
    local list = getToolNames()
    -- giữ tool đã lưu trong list để dropdown hiển thị đúng dù đang không có trong balo
    if cfg.equipTool ~= "" and not table.find(list, cfg.equipTool) then
        table.insert(list, cfg.equipTool)
    end
    if #list == 0 then list = {NO_TOOL} end
    return list
end

local function refreshToolList(silent)
    local list = buildToolList()
    local done = false
    if equipDrop then
        for _, method in ipairs({"Refresh", "SetList", "UpdateList"}) do
            if type(equipDrop[method]) == "function" then
                local ok = pcall(function() equipDrop[method](equipDrop, list) end)
                if ok then done = true break end
            end
        end
    end
    if not silent then
        if done then
            setStatus("🔄 Đã cập nhật danh sách tool (" .. #getToolNames() .. " tool)", GREEN)
        else
            setStatus("❌ Library không hỗ trợ refresh dropdown", RED)
        end
    end
end

