local function httpGet(url)
    if httpRequest then
        local ok, res = pcall(httpRequest, {Url = url, Method = "GET"})
        if ok and res then
            if res.StatusCode == 200 then return res.Body end
            return nil, res.StatusCode
        end
        return nil, 0
    end
    local ok, body = pcall(game.HttpGet, game, url)
    if ok then return body end
    return nil, 0
end

local function getPage(cursor, silent)
    local hostIdx = 1
    for attempt = 1, 4 do
        local url = string.format(
            "https://%s/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
            HOSTS[hostIdx], PlaceId, cursor ~= "" and ("&cursor=" .. cursor) or "")
        local body = httpGet(url)
        if body then
            local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
            if ok and type(data) == "table" and data.data then return data end
        end
        if attempt == 4 then break end
        hostIdx = hostIdx % #HOSTS + 1
        local wait = attempt * 4
        if not silent then
            setStatus(string.format("API bị giới hạn, thử lại sau %ds (%d/4)...", wait, attempt), YELLOW)
        end
        waitCancelable(wait)
        if cancelFlag then return nil end
    end
    return nil
end

local function fetchServers(silent)
    local servers, cursor = {}, ""
    for page = 1, MAX_PAGES do
        local res = getPage(cursor, silent)
        if not res then
            if page == 1 then return nil end
            break
        end
        for _, s in ipairs(res.data) do
            if s.id ~= JobId and s.playing and s.playing >= 2 and s.playing <= 5
                and s.playing < s.maxPlayers then
                servers[#servers + 1] = s
            end
        end
        if not res.nextPageCursor then break end
        cursor = res.nextPageCursor
        waitCancelable(1.5)
        if cancelFlag then return nil end
    end
    return servers
end

local function doHop()
    local servers
    if tick() - serverCache.time < CACHE_TIME and #serverCache.list > 0 then
        servers = serverCache.list
        setStatus("Dùng danh sách server đã lưu...", YELLOW)
    else
        setStatus("Đang lấy danh sách server...", YELLOW)
        servers = fetchServers(false)
        if cancelFlag then setStatus("Đã hủy hop!", RED) return end
        if not servers then
            setStatus("API vẫn bị chặn, đợi ~1 phút rồi bấm lại!", RED)
            return
        end
        serverCache.time = tick()
        serverCache.list = servers
    end

    if #servers == 0 then
        setStatus("Không có server 2-5 người!", RED)
        return
    end

    local fresh = {}
    for _, s in ipairs(servers) do
        if not visitedServers[s.id] then fresh[#fresh + 1] = s end
    end
    if #fresh == 0 then
        for k in pairs(visitedServers) do visitedServers[k] = nil end
        visitedServers[JobId] = true
        fresh = servers
    end

    local chosen = fresh[math.random(#fresh)]
    visitedServers[chosen.id] = true
    for i, s in ipairs(serverCache.list) do
        if s.id == chosen.id then table.remove(serverCache.list, i) break end
    end

    setStatus("Vào server (" .. chosen.playing .. " người)...", GREEN)
    task.wait(1)
    pcall(function() TeleportService:TeleportToPlaceInstance(PlaceId, chosen.id, LocalPlayer) end)
end

