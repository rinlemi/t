local BOSS_NAME      = "Emerald Swordsman"
local BEHIND_DIST    = 3
local SWORD_NAME     = "" -- để trống: dùng tool đang cầm và click chuột
local BOSS_SCAN_TIME = 12
local FIGHT_TIMEOUT  = 300
local DROP_WAIT      = 6
local farmToggle, huntToggle
local orbNotified = false

local function getBoss()
    local w = workspace:FindFirstChild("World")
    local p = w and w:FindFirstChild("Playability")
    local f = p and p:FindFirstChild("Enemys")
    local b = f and f:FindFirstChild(BOSS_NAME)
    local h = b and b:FindFirstChildOfClass("Humanoid")
    if b and h and h.Health > 0 and b:FindFirstChild("HumanoidRootPart") then
        return b
    end
    return nil
end

local function hasDualOrb()
    for _, c in ipairs({LocalPlayer:FindFirstChildOfClass("Backpack"), LocalPlayer.Character}) do
        if c then
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") and t.Name:lower():find("dual orb", 1, true) then
                    return true
                end
            end
        end
    end
    return false
end

local function onDualOrb()
    if orbNotified then return end
    orbNotified = true
    cfg.farmBoss, cfg.huntBoss, cfg.rareStop = false, false, true
    cfg.autoLoot = false
    cancelFlag = true
    pcall(function() if farmToggle then farmToggle:Set(false) end end)
    pcall(function() if huntToggle then huntToggle:Set(false) end end)
    pcall(function() if autoToggle then autoToggle:Set(false) end end)
    saveConfig()
    setStatus("🔮 Nhặt được Dual Orb → đã dừng, không hop nữa", GREEN)
    task.spawn(function()
        task.wait(1.5)
        local ok, err = postWebhook({
            title = "🔮 Nhặt được Dual Orb!",
            color = 0xAA55FF,
            fields = {
                {name = "Beli hiện tại", value = getBeli(), inline = true},
                {name = "Server (JobId)", value = tostring(JobId), inline = false},
            },
            footer = {text = LocalPlayer.Name},
            timestamp = DateTime.now():ToIsoDate(),
        })
        if not ok then warn("[Hub] Webhook Dual Orb lỗi: " .. tostring(err)) end
    end)
end

local function swing()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local tool = char:FindFirstChildOfClass("Tool")
    if SWORD_NAME ~= "" and not (tool and tool.Name == SWORD_NAME) then
        local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
        local t = bp and bp:FindFirstChild(SWORD_NAME)
        if t then
            pcall(function() hum:EquipTool(t) end)
            tool = t
        end
    end

    if tool then pcall(function() tool:Activate() end) end
    local vs = workspace.CurrentCamera.ViewportSize
    pcall(function()
        VIM:SendMouseButtonEvent(vs.X / 2, vs.Y / 2, 0, true, game, 1)
        VIM:SendMouseButtonEvent(vs.X / 2, vs.Y / 2, 0, false, game, 1)
    end)
end

local function fightBoss(boss)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local bh = boss:FindFirstChild("HumanoidRootPart")
    if not (root and bh) then return end

    setStatus("⚔️ Bay ra sau " .. BOSS_NAME .. "...", YELLOW)
    SafeTween((bh.CFrame * CFrame.new(0, 0, BEHIND_DIST)).Position, cfg.islandSpeed, 0)
    if cancelFlag then return end

    local conn = RunService.Heartbeat:Connect(function()
        local h = boss:FindFirstChild("HumanoidRootPart")
        if h and root.Parent then
            local pos = (h.CFrame * CFrame.new(0, 0, BEHIND_DIST)).Position
            root.CFrame = CFrame.lookAt(pos, Vector3.new(h.Position.X, pos.Y, h.Position.Z))
            root.AssemblyLinearVelocity = Vector3.zero
        end
    end)

    setStatus("⚔️ Đang đánh " .. BOSS_NAME .. "...", GREEN)
    local t0 = tick()
    while not cancelFlag and boss.Parent and tick() - t0 < FIGHT_TIMEOUT do
        local h = boss:FindFirstChildOfClass("Humanoid")
        if not h or h.Health <= 0 then break end
        swing()
        task.wait(0.12)
    end
    conn:Disconnect()
end

local function afterBossDie()
    setStatus("Boss chết, đợi drop...", YELLOW)
    local t0 = tick()
    while tick() - t0 < DROP_WAIT and not cancelFlag and not getDF() do
        task.wait(0.2)
    end
    if getDF() and not cancelFlag then pickupDF(nil) end
    waitCancelable(1.5)
    if hasDualOrb() then onDualOrb(); return true end
    return false
end

local function farmLoop()
    waitCancelable(3)
    while not cancelFlag and env.HubGen == myGen do
        local boss = getBoss()
        if boss then
            fightBoss(boss)
            if cancelFlag then break end
            if afterBossDie() then break end
        else
            setStatus("Chờ " .. BOSS_NAME .. " hồi sinh...", YELLOW)
            waitCancelable(1)
        end
    end
end

local function huntLoop()
    waitCancelable(3)
    while not cancelFlag and env.HubGen == myGen do
        local t0 = tick()
        setStatus("Đang tìm " .. BOSS_NAME .. "...", YELLOW)
        while not cancelFlag and tick() - t0 < BOSS_SCAN_TIME and not getBoss() do
            task.wait(0.5)
        end
        if cancelFlag then break end
        local boss = getBoss()
        if boss then
            fightBoss(boss)
            if cancelFlag then break end
            if afterBossDie() then break end
        else
            setStatus("Không thấy boss → hop server", YELLOW)
        end
        if cancelFlag then break end
        doHop()
        waitCancelable(20)
    end
end

