local NO_TOOL = "(không có tool)"

local function getToolNames()
    local names, seen = {}, {}
    local function scan(container)
        if not container then return end
        for _, t in ipairs(container:GetChildren()) do
            if t:IsA("Tool") and not seen[t.Name] then
                seen[t.Name] = true
                names[#names + 1] = t.Name
            end
        end
    end
    scan(LocalPlayer:FindFirstChildOfClass("Backpack"))
    scan(LocalPlayer.Character)
    table.sort(names)
    return names
end

local function equipByName(name)
    if not name or name == "" or name == NO_TOOL then return false end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if char:FindFirstChild(name) then return true end -- đang cầm rồi
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    local tool = bp and bp:FindFirstChild(name)
    if tool and tool:IsA("Tool") then
        pcall(function() hum:EquipTool(tool) end)
        return true
    end
    return false
end

