local function getChestFolder()
    local w = workspace:FindFirstChild("World")
    local p = w and w:FindFirstChild("Playability")
    return p and p:FindFirstChild("Chests")
end

local function CollectChestsOnIsland(islPos, withDF)
    local chestFolder = getChestFolder()
    if not chestFolder then return 0, 0 end
    local collected, dfGot = 0, 0
    for _, chest in ipairs(chestFolder:GetChildren()) do
        if cancelFlag then break end
        if withDF then
            dfGot += tryDF(islPos)
            if cancelFlag then break end
        end
        if chest:IsA("Model") then
            local prompt = chest:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt and fireproximityprompt then
                pcall(function() fireproximityprompt(prompt) end)
                collected += 1
                task.wait(0.2)
            else
                local hitbox = chest:FindFirstChild("Hitbox") or chest:FindFirstChild("RootPart")
                local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hitbox and root then
                    root.CFrame = CFrame.new(hitbox.Position + Vector3.new(0, 2, 0))
                    collected += 1
                    task.wait(0.15)
                end
            end
        end
    end
    return collected, dfGot
end

local function lootRoute(withDF)
    local route = {}
    for _, isl in ipairs(ISLANDS) do route[#route + 1] = isl end
    route[#route + 1] = ISLANDS[1]

    lootStats = {items = {}, beliStart = getBeli and getBeli() or nil}
    lootActive = true

    local totalChest, totalDF = 0, 0
    for i, isl in ipairs(route) do
        if cancelFlag then break end
        setStatus(string.format("Đang bay tới %s (%d/%d)...", isl.Name, i, #route), YELLOW)
        SafeTween(isl.Pos, LOOT_FLY_SPEED, ISLAND_Y)
        if cancelFlag then break end

        setStatus("Đang tải Chest " .. isl.Name .. "...", YELLOW)
        local t0 = tick()
        while tick() - t0 < cfg.loadDelay and not cancelFlag do
            if withDF then totalDF += tryDF(isl.Pos) end
            task.wait(0.1)
        end
        if cancelFlag then break end

        setStatus("Đang nhặt Chest " .. isl.Name .. "...", YELLOW)
        local c, d = CollectChestsOnIsland(isl.Pos, withDF)
        totalChest += c
        totalDF += d
        print(string.format("[Hub] %s: %d chest, %d DF", isl.Name, c, d))
        if withDF then totalDF += tryDF(isl.Pos) end
        waitCancelable(0.5)
    end

    lootActive = false
    local summary = withDF
        and string.format("Chest: %d | DF: %d", totalChest, totalDF)
        or  string.format("Tổng cộng: %d Chest", totalChest)

    if cancelFlag then
        setStatus((cfg.rareStop and "🎉 Nhặt được DF đã chọn! " or "Đã dừng! ") .. summary, cfg.rareStop and GREEN or RED)
    else
        setStatus("Xong! " .. summary, GREEN)
        -- gửi webhook tổng kết TRƯỚC khi hop (hop sẽ cắt script)
        if cfg.webhookSummary and sendLootSummary then
            pcall(sendLootSummary, totalChest, totalDF)
        end
        if cfg.hopAfter then
            task.wait(1)
            doHop()
        end
    end
end

local function lootChests() lootRoute(false) end

local autoToggle

local function autoLootLoop()
    waitCancelable(3)
    while not cancelFlag and env.HubGen == myGen do
        lootRoute(true)
        if cancelFlag or cfg.rareStop then break end
        if cfg.hopAfter then
            waitCancelable(20)
        else
            setStatus("Xong vòng, nghỉ " .. AUTO_LOOT_GAP .. "s rồi loot tiếp...", GREEN)
            waitCancelable(AUTO_LOOT_GAP)
        end
    end
    if cfg.rareStop then
        cfg.autoLoot = false
        pcall(function() autoToggle:Set(false) end)
    end
end

