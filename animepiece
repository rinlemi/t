local function saveConfig()
    if not writefile then return false end
    local data = {
        webhook        = cfg.webhook,
        stopOnRare     = cfg.stopOnRare,
        fruits         = cfg.fruits,
        hopAfter       = cfg.hopAfter,
        loadDelay      = cfg.loadDelay,
        islandSpeed    = cfg.islandSpeed,
        killPercent    = math.floor(killThreshold * 100 + 0.5),
        killEnabled    = killEnabled,
        autoLoot       = cfg.autoLoot,
        webhookSummary = cfg.webhookSummary,
        farmBoss       = cfg.farmBoss,
        huntBoss       = cfg.huntBoss,
        -- [MỚI]
        autoM1         = cfg.autoM1,
        m1Delay        = cfg.m1Delay,
        autoEquip      = cfg.autoEquip,
        equipTool      = cfg.equipTool,
    }
    local ok, err = pcall(function() writefile(CONFIG_FILE, HttpService:JSONEncode(data)) end)
    if not ok then warn("[Hub] Lưu config lỗi: " .. tostring(err)) end
    return ok
end

local function loadConfig()
    if not (isfile and readfile and isfile(CONFIG_FILE)) then return end
    local ok, d = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
    if not ok or type(d) ~= "table" then return end

    if type(d.webhook) == "string" then cfg.webhook = d.webhook end
    if type(d.stopOnRare) == "boolean" then cfg.stopOnRare = d.stopOnRare end
    if type(d.hopAfter) == "boolean" then cfg.hopAfter = d.hopAfter end
    if type(d.autoLoot) == "boolean" then cfg.autoLoot = d.autoLoot end
    if type(d.webhookSummary) == "boolean" then cfg.webhookSummary = d.webhookSummary end
    if type(d.farmBoss) == "boolean" then cfg.farmBoss = d.farmBoss end
    if type(d.huntBoss) == "boolean" then cfg.huntBoss = d.huntBoss end
    if type(d.killEnabled) == "boolean" then killEnabled = d.killEnabled end
    -- [MỚI]
    if type(d.autoM1) == "boolean" then cfg.autoM1 = d.autoM1 end
    if type(d.autoEquip) == "boolean" then cfg.autoEquip = d.autoEquip end
    if type(d.equipTool) == "string" then cfg.equipTool = d.equipTool end
    if type(d.m1Delay) == "number" then cfg.m1Delay = math.clamp(d.m1Delay, 0.1, 1) end

    if type(d.fruits) == "table" then
        for _, f in ipairs(RARE_FRUITS) do
            if type(d.fruits[f.key]) == "boolean" then cfg.fruits[f.key] = d.fruits[f.key] end
        end
    end
    if type(d.loadDelay) == "number" then cfg.loadDelay = math.clamp(d.loadDelay, 0.5, 6) end
    if type(d.islandSpeed) == "number" then cfg.islandSpeed = math.clamp(d.islandSpeed, 100, 2000) end
    if type(d.killPercent) == "number" then killThreshold = math.clamp(d.killPercent, 1, 100) / 100 end
end

