        if current == name then return end
        if current then
            setStatus("Đang bận: " .. current .. " → tắt việc đó trước", RED)
            cfg[key] = false
            local ref = getToggle()
            pcall(function() if ref then ref:Set(false) end end)
            return
        end
        start(name, fn)
    elseif current == name then
        cancelFlag = true
        setStatus("Đang dừng " .. name .. "...", RED)
    end
end

