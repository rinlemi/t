local current = nil
local cancelFlag = false

local function runTask(name, fn)
    if current == name then
        cancelFlag = true
        setStatus("Đang dừng...", RED)
        return
    end
    if current then
        setStatus("Đang bận: " .. current .. " (bấm lại nút đó để dừng)", RED)
        return
    end
    current = name
    cancelFlag = false
    task.spawn(function()
        local ok, err = xpcall(fn, function(e) return tostring(e) .. "\n" .. debug.traceback() end)
        if not ok then
            warn("[Hub] Lỗi: " .. tostring(err))
            setStatus("Lỗi: " .. tostring(err):match("^[^\n]*"), RED)
        end
        lootActive = false
        current = nil
        cancelFlag = false
    end)
end

local function waitCancelable(sec)
