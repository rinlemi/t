sendLootSummary = function(totalChest, totalDF)
    task.wait(1.5)
    local counts, order = {}, {}
    for _, name in ipairs(lootStats.items) do
        if not counts[name] then counts[name] = 0 order[#order + 1] = name end
        counts[name] += 1
    end
    local lines = {}
    for _, name in ipairs(order) do
        lines[#lines + 1] = "• " .. name .. (counts[name] > 1 and (" x" .. counts[name]) or "")
    end
    local itemsText = #lines > 0 and table.concat(lines, "\n") or "Không có vật phẩm mới"
    if #itemsText > 1000 then itemsText = itemsText:sub(1, 1000) .. "..." end

    local beliNow = getBeli()
    local a, b = toNum(lootStats.beliStart), toNum(beliNow)
    local diff = (a and b) and (b - a) or nil
    local diffText = diff and ((diff >= 0 and "+" or "") .. tostring(diff)) or "không tính được"

    local ok, err = postWebhook({
        title  = "✅ Loot xong",
        color  = 0x00FF88,
        fields = {
            {name = "Chest đã nhặt",     value = tostring(totalChest), inline = true},
            {name = "DF nhặt được",      value = tostring(totalDF), inline = true},
            {name = "Vật phẩm vừa nhặt", value = itemsText, inline = false},
            {name = "Beli hiện tại",     value = beliNow, inline = true},
            {name = "Beli thay đổi",     value = diffText, inline = true},
        },
        footer    = {text = LocalPlayer.Name},
        timestamp = DateTime.now():ToIsoDate(),
    })
    if not ok then warn("[Hub] Webhook tổng kết lỗi: " .. tostring(err)) end
end

