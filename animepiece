local function watchTool(tool, graceUntil)
    if env.HubGen ~= myGen then return end
    if not tool:IsA("Tool") or seenTools[tool] then return end
    seenTools[tool] = true
    if tick() < graceUntil then return end
    if lootActive then lootStats.items[#lootStats.items + 1] = tool.Name end
    if tool.Name:lower():find("dual orb", 1, true) then onDualOrb() end
    local fruit = matchSelectedFruit(tool.Name)
    if fruit then onRareFruit(fruit) end
end

local function bindInventory()
    local graceUntil = tick() + 8
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:WaitForChild("Backpack", 10)
    local function hook(container)
        if not container then return end
        for _, t in ipairs(container:GetChildren()) do seenTools[t] = true end
        container.ChildAdded:Connect(function(t) watchTool(t, graceUntil) end)
    end
    hook(bp)
    hook(LocalPlayer.Character)
end

