local function toNum(s)
    local n = tonumber((tostring(s or ""):gsub("[^%d]", "")))
    return n
end

local function postWebhook(embed)
    local url = (cfg.webhook or ""):gsub("%s+", "")
    if url == "" then return false, "Chưa nhập Webhook" end
    if not httpRequest then return false, "Executor không hỗ trợ request" end
    local body = HttpService:JSONEncode({username = "Fruit Notifier", embeds = {embed}})
    local ok, res = pcall(httpRequest, {
        Url = url,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = body,
    })
    if ok and res and (res.StatusCode == 200 or res.StatusCode == 204) then
        return true
    end
    return false, "HTTP " .. tostring(ok and res and res.StatusCode or "lỗi")
end

local function sendWebhook(fruitName, isTest)
    return postWebhook({
        title  = isTest and "🧪 Test Webhook" or "🍎 Nhặt được DF hiếm!",
        color  = isTest and 0x5865F2 or 0x00FF88,
        fields = {
            {name = "DF vừa nhặt",   value = fruitName, inline = true},
            {name = "Beli hiện tại", value = getBeli(), inline = true},
        },
        footer    = {text = LocalPlayer.Name},
        timestamp = DateTime.now():ToIsoDate(),
    })
