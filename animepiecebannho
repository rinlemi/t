        if not ok then
            warn("[Hub] Lỗi: " .. tostring(err))
            setStatus("Lỗi: " .. tostring(err):match("^[^\n]*"), RED)
        end
        lootActive = false
        current = nil
        cancelFlag = false
    end)
end

