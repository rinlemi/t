--  BAY BẰNG TWEEN
-- =====================================================================
local function SafeTween(targetPos, speed, yOffset)
    local char = LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and root) or hum.Health <= 0 then return false end

    local goal = targetPos + Vector3.new(0, yOffset or 0, 0)
    local dist = (goal - root.Position).Magnitude
    if dist < 5 then return true end

    pcall(function()
        hum:ChangeState(Enum.HumanoidStateType.Physics)
        root.AssemblyLinearVelocity = Vector3.zero
    end)

    local rot = root.CFrame - root.CFrame.Position
    local tween = TweenService:Create(root,
        TweenInfo.new(dist / math.max(speed, 1), Enum.EasingStyle.Linear),
        {CFrame = CFrame.new(goal) * rot})

    local finished, completed = false, false
    local c1 = tween.Completed:Connect(function(state)
        finished = true
        completed = (state == Enum.PlaybackState.Completed)
    end)
    local c2 = RunService.Heartbeat:Connect(function()
        if root.Parent then root.AssemblyLinearVelocity = Vector3.zero end
    end)

    tween:Play()
    while not finished do
        if cancelFlag or not root.Parent or hum.Health <= 0 then
            tween:Cancel()
            break
        end
        task.wait(0.05)
    end
    c1:Disconnect()
    c2:Disconnect()
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end)
    return completed
end

