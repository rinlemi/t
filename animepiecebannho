local function runTask(name, fn)
    if current == name then
        cancelFlag = true
        setStatus("Đang dừng...", RED)
        return
    end
    if current then
        setStatus("Đang bận: " .. current .. " (bấm lại nút đó để dừng)", RED)
        return
    end
    current = name
    cancelFlag = false
    task.spawn(function()
