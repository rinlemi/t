-- =====================================================================
local function scanDF()
    if getDF() then
        setStatus("DF đã ở ngay đây!", GREEN)
        pickupDF(nil)
        return
    end
    for i, isl in ipairs(ISLANDS) do
        if cancelFlag then break end
        setStatus(string.format("Bay tới %s (%d/%d)...", isl.Name, i, #ISLANDS), YELLOW)
        SafeTween(isl.Pos, cfg.islandSpeed, ISLAND_Y)
        if cancelFlag then break end
        setStatus("Đang quét " .. isl.Name .. "...", YELLOW)
        local t0 = tick()
        while tick() - t0 < SCAN_DELAY and not cancelFlag do
            if getDF() then
                setStatus("🔥 TÌM THẤY DF tại " .. isl.Name .. "!", GREEN)
                pickupDF(nil)
                return
            end
            task.wait(0.1)
        end
    end
    if cancelFlag then
        setStatus("Đã hủy quét DF!", RED)
    else
        setStatus("Đã quét hết 5 đảo, không thấy DF!", RED)
    end
end

