local dfSkipUntil = 0

local function getDF()
    local w = workspace:FindFirstChild("World")
    local p = w and w:FindFirstChild("Playability")
    local dt = p and p:FindFirstChild("DroppedTools")
    return dt and dt:FindFirstChild("Handle")
end

local function getDFPrompt(df)
    if not df then return nil end
    return df:FindFirstChildWhichIsA("ProximityPrompt", true)
        or (df.Parent and df.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))
end

local function pressE(duration)
    pcall(function() VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game) end)
    waitCancelable(duration)
    pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game) end)
end

local function pickupDF(returnPos)
    for attempt = 1, 4 do
        if cancelFlag then return false end
        local df = getDF()
        if not df then return true end
        setStatus(string.format("🔥 Thấy DF! Bay tới nhặt (%d/4)...", attempt), GREEN)
        SafeTween(df.Position, DF_SPEED, 2)
        if cancelFlag then return false end
        waitCancelable(0.4)
        local cur = getDF()
        if cur then
            local prompt = getDFPrompt(cur)
            local hold = prompt and prompt.HoldDuration or 0
            pressE(math.max(hold, 0.3) + 0.2)
            waitCancelable(0.5)
            if getDF() and not cancelFlag and prompt and fireproximityprompt then
                pcall(function() fireproximityprompt(prompt) end)
                waitCancelable(0.5)
            end
        end
        if not getDF() then
            setStatus("✅ Đã nhặt DF!", GREEN)
            if returnPos and not cancelFlag then
                SafeTween(returnPos, cfg.islandSpeed, ISLAND_Y)
            end
            return true
        end
    end
    dfSkipUntil = tick() + 20
    setStatus("Nhặt DF thất bại, bỏ qua 20s", RED)
    return false
end

local function tryDF(returnPos)
    if cancelFlag or tick() < dfSkipUntil then return 0 end
    if not getDF() then return 0 end
    return pickupDF(returnPos) and 1 or 0
end

