-- ===== CỜ "CẦN LUYỆN STAT" =====
local function setFlag()
  pcall(function() if writefile then writefile(FLAG, "1") end end)
end
local function clearFlag()
  pcall(function() if isfile and delfile and isfile(FLAG) then delfile(FLAG) end end)
end
local function hasFlag()
  local r = false
  pcall(function() r = (isfile and isfile(FLAG)) and true or false end)
  return r
end

