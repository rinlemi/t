    end

    if not prompt then
        print("   ⚠️ Không có ProximityPrompt → fallback sit")
        pcall(function() seat:Sit(hum) end)
        task.wait(1.5)
        return hum.SeatPart ~= nil
    end

    local holdDur = prompt.HoldDuration or 0
    print(string.format("   🪑 Prompt: %s | Hold: %.2fs", prompt:GetFullName(), holdDur))

    for attempt = 1, 6 do
        if hum.SeatPart then
            print("   ✅ Đã ngồi (SeatPart = " .. hum.SeatPart.Name .. ")")
            return true
        end

        local carCF = car and car:GetPivot() or seat.CFrame
        local sideOffset = carCF:VectorToWorldSpace(Vector3.new(4, 0, 0))
        local standPos = CFrame.new(seat.Position + sideOffset + Vector3.new(0, 2, 0))

        pcall(function() hrp.CFrame = standPos end)
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
        task.wait(0.6)

        if fireproximityprompt then
            pcall(function() fireproximityprompt(prompt) end)
            task.wait(math.max(holdDur, 0.3) + 0.5)
        end

        if not hum.SeatPart then
            -- Bỏ hoàn toàn VIM, chỉ dựa vào fireproximityprompt
            pcall(function() seat:Sit(hum) end)
            task.wait(0.5)
        end

        print(string.format("   🔄 Lần %d | Seated: %s", attempt, tostring(hum.SeatPart ~= nil)))
    end

    return hum.SeatPart ~= nil
end

local function setupRaceConstraints(root)
    for _, n in ipairs({"RaceAttachment", "RaceLinearVelocity", "RaceAlignOrientation"}) do
        local old = root:FindFirstChild(n)
        if old then old:Destroy() end
    end

    local force = MAX_FORCE
    if FORCE_PER_MASS > 0 then
        local okM, mass = pcall(function() return root.AssemblyMass end)
        if okM and type(mass) == "number" then force = math.max(force, mass * FORCE_PER_MASS) end
    end

    local att = Instance.new("Attachment")
    att.Name = "RaceAttachment"
    att.Parent = root

    local lv = Instance.new("LinearVelocity")
    lv.Name = "RaceLinearVelocity"
    lv.Attachment0 = att
    lv.MaxForce = force
    lv.VectorVelocity = Vector3.zero
    lv.RelativeTo = Enum.ActuatorRelativeTo.World
    pcall(function()
        lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
        lv.MaxAxesForce = Y_FORCE_FULL
            and Vector3.new(force, force, force)
            or  Vector3.new(force, 0, force)
    end)
    lv.Parent = root

    local ao = Instance.new("AlignOrientation")
    ao.Name = "RaceAlignOrientation"
    ao.Attachment0 = att
    ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
    ao.MaxTorque = MAX_FORCE
    ao.Responsiveness = math.clamp(AO_RESPONSIVE, 1, 200)
    ao.RigidityEnabled = false
    ao.Parent = root

    return lv, ao, att
end

local function cleanupRace(lv, ao, att)
    if lv  then pcall(function() lv:Destroy()  end) end
    if ao  then pcall(function() ao:Destroy()  end) end
    if att then pcall(function() att:Destroy() end) end
end

local function runLap(car, seat)
    local root = seat.AssemblyRootPart or seat
    local hum  = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    if not (car and car.Parent and seat.Parent and root) then return false end
    if G < 2 then print("   ❌ Chưa dựng được lưới tốc độ từ path") return false end

    local var    = pickLapVariation()
    local cruise = math.min(SPEED, MAX_SAFE_SPEED)
    local prof   = buildLapProfile(cruise, var.alatMul, var.decelMul)

    local d0, dist0 = nearestD(root.Position)
    if dist0 > MAX_PATH_DIST then
        return false, "far_from_path"
    end

    local t0 = os.clock()
    local d  = d0
    local maxT = (TOTAL - d0) / math.max(cruise * 0.6, 20) * 1.4 + 20

    local releaseDist = math.max(RELEASE_MIN_DIST, cruise * RELEASE_TIME_AHEAD) * rnd(0.85, 1.5)
    local finishOS    = rnd(FINISH_OVERSHOOT_MIN, FINISH_OVERSHOOT_MAX)
    local finishDrift = rnd(-FINISH_DRIFT, FINISH_DRIFT)
    local finishShape = rnd(0.85, 1.15)
    local released, releaseT0, releaseV0, releaseDur = false, 0, 0, 0

    local span0 = LOOKAHEAD * var.lookaheadMul
    local pA = at(d0)
    local pB = at(math.min(d0 + span0, TOTAL))
    local vdir, hm0 = flatDir(pA, pB, nil)
    if not vdir then
        local lvv = root.CFrame.LookVector
        vdir = flatDir(Vector3.zero, Vector3.new(lvv.X, 0, lvv.Z), Vector3.new(0, 0, -1))
    end
    local slopeF = hm0 and hm0 > 1 and (pB.Y - pA.Y) / hm0 or 0

    local function poseDir(dir, roll, pitch)
        return CFrame.lookAt(Vector3.zero, dir * CAR_FORWARD_SIGN)
            * CFrame.Angles(pitch * CAR_FORWARD_SIGN, 0, roll * CAR_FORWARD_SIGN)
            * CFrame.Angles(0, math.rad(YAW), 0)
    end
    local function bodyDirOf(vd, slope) return (vd + Vector3.new(0, slope, 0)).Unit end

    local v, aLong, T, B = 0, 0, 0, 0
    do
        local rv = root.AssemblyLinearVelocity
        v = math.min(Vector3.new(rv.X, 0, rv.Z).Magnitude, 60)
    end
    local function gearOf(s)
        local g = 0
        for _, sv in ipairs(GEAR_SHIFTS) do if s >= sv then g = g + 1 end end
        return g
    end
    local lastGear, shiftEnd = gearOf(v), 0

    local wS, rollF = 0, 0          
    local laneX, laneV, laneTarget, nextLane = 0, 0, 0, os.clock() + rnd(2, 5)
    local ph1, ph2 = math.random() * 6.28, math.random() * 6.28

    local ev
    local nextEv = os.clock() + rnd(8, 14)
    local evCount = 0

    local sOn, sUntil, sNext, pressCount = false, 0, 0, 0
    local function driveKeys(now)
        if USE_KEY_S then
            if sOn then
                if now >= sUntil or v < 5 then
                    sOn = false
                    sNext = now + rnd(0.06, 0.18)
                end
            elseif B > BRAKE_KEY_THRESHOLD and v > BRAKE_KEY_MIN_SPEED and now >= sNext then
                sOn = true
                pressCount += 1
                sUntil = now + math.clamp(0.10 + B * 0.45, 0.10, 0.5)
            end
        end
    end

    local lv, ao, att = setupRaceConstraints(root)
    lv.VectorVelocity = Vector3.zero
    ao.CFrame = poseDir(bodyDirOf(vdir, slopeF), 0, 0)
    task.wait(WARMUP_TIME)

    if root.Parent then
        d = select(1, projectD(root.Position, d0))
    end

    local launchT0 = os.clock()
    local reaction = rnd(REACTION_MIN, REACTION_MAX)
    local uiNext, maxV = 0, 0

    while running do
        local dt  = math.min(RS.Heartbeat:Wait(), 0.05)
        local now = os.clock()

        if not car.Parent or not seat.Parent or not root.Parent then
            cleanupRace(lv, ao, att)
            return false
        end

        if hum and not hum.SeatPart then
            cleanupRace(lv, ao, att)
            return false, "ejected"
        end

        if now - t0 > maxT then
            smoothStop(lv, root, STOP_TIME_STOP)
            cleanupRace(lv, ao, att)
            return false
        end

        local realPos = root.Position
        local realD, distToPath = projectD(realPos, d)
        if distToPath <= MAX_PATH_DIST then
            d = math.min(realD, TOTAL)
        else
            d = math.min(d + v * dt * 0.5, TOTAL)
        end

        if not released and d >= TOTAL - releaseDist then
            released  = true
            releaseT0 = now
            releaseV0 = math.max(v, 1)
            local want = (TOTAL - d) + finishOS
            releaseDur = math.clamp(2.2 * want / math.max(releaseV0, 30), FINISH_DUR_MIN, FINISH_DUR_MAX)
        end

        local span  = LOOKAHEAD * var.lookaheadMul + v * 0.05
        local pAt   = at(d)
        local aheadP = at(math.min(d + span, TOTAL))
        local tNow, hmag = flatDir(pAt, aheadP, vdir)
        local rightNow = Vector3.new(-tNow.Z, 0, tNow.X)

        if now >= nextLane then
            if math.random() < 0.3 then
                laneTarget = rnd(-1, 1)
            else
                laneTarget = rnd(-var.laneMax, var.laneMax)
            end
            nextLane = now + rnd(LANE_CHANGE_MIN, LANE_CHANGE_MAX)
        end
        local laneAcc = LANE_OMEGA ^ 2 * (laneTarget - laneX) - 2 * LANE_OMEGA * laneV
        laneV = math.clamp(laneV + laneAcc * dt, -LANE_MAX_VEL, LANE_MAX_VEL)
        laneX = laneX + laneV * dt

        local kAbs     = gridAt(gAbsK, d + 20)
        local laneGain = 1 - math.clamp(kAbs * 400, 0, 0.7)   
        local lat = laneX * laneGain + gridAt(gRace, d) * var.raceScale
        lat = math.clamp(lat, -LAT_TOTAL_MAX, LAT_TOTAL_MAX)
        lat = lat * math.clamp((LAT_FADE_DIST + 6 - distToPath) / 6, 0, 1)

        local off = Vector3.new(realPos.X - pAt.X, 0, realPos.Z - pAt.Z)
        local e = off:Dot(rightNow) - lat                      
        local corr = math.clamp(math.atan(STEER_KE * e / (v + STEER_KS)), -STEER_MAX_CORR, STEER_MAX_CORR)
        if released then   
            corr = corr + finishDrift * math.clamp((now - releaseT0) / 0.5, 0, 1)
        end
        local desired = rotY(tNow, corr)

        local crossY = vdir.Z * desired.X - vdir.X * desired.Z
        local dotV   = vdir.X * desired.X + vdir.Z * desired.Z
        local errA   = math.atan2(crossY, dotV)
        local kff    = gridAt(gKL, d + span * 0.5)
        local wMax   = A_LAT_MAX * STEER_LAT_MUL / math.max(v, 30)
        local w      = math.clamp(HEADING_GAIN * errA + v * kff, -wMax, wMax)

        vdir = rotY(vdir, w * dt)
        vdir = vdir.Magnitude > 0.01 and vdir.Unit or tNow
        wS = wS + (w - wS) * math.clamp(dt / 0.15, 0, 1)

        if released then
            local x = math.clamp((now - releaseT0) / releaseDur, 0, 1)
            if x >= 1 then
                if lv.Parent then lv.VectorVelocity = Vector3.zero end
                task.wait(0.2)
                cleanupRace(lv, ao, att)
                return true
            end
            local xs = x ^ finishShape
            local vPrev = v
            v = releaseV0 * (1 - (3 * xs * xs - 2 * xs * xs * xs))   
            aLong = (v - vPrev) / math.max(dt, 1e-3)
            T = 0
            B = math.clamp(-aLong / BRAKE_MAX, 0, 1)
        else
            local vtBase  = gridAt(prof, d + v * PREVIEW_TIME)
            local vtAhead = gridAt(prof, d + v * PREVIEW_TIME + 8)
            local slopeV  = (vtAhead - vtBase) / 8
            local speedMod = 1 + math.sin(now * var.slowFreq + var.slowPhase) * var.slowAmp
            local vt = vtBase * speedMod

            local evBrake = 0
            if ev then
                if now >= ev.t1 then
                    ev = nil
                elseif ev.kind == "lift" then
                    local x = (now - ev.t0) / (ev.t1 - ev.t0)
                    vt = vt * (1 - ev.depth * math.sin(math.pi * x))
                else
                    evBrake = ev.level
                end
            end
            if EVENTS_ENABLED and not ev and now >= nextEv
                and now - launchT0 > 8 and v > 0.6 * vtBase
                and d < TOTAL - 500 and gridAt(gAbsK, d) < 1 / 300 then
                if math.random() < LIFT_CHANCE then
                    ev = {kind = "lift", t0 = now, t1 = now + rnd(LIFT_DUR_MIN, LIFT_DUR_MAX),
                          depth = rnd(LIFT_DEPTH_MIN, LIFT_DEPTH_MAX)}
                else
                    ev = {kind = "tap", t0 = now, t1 = now + rnd(TAP_DUR_MIN, TAP_DUR_MAX),
                          level = rnd(TAP_LEVEL_MIN, TAP_LEVEL_MAX)}
                end
                evCount += 1
                nextEv = ev.t1 + rnd(EVENT_GAP_MIN, EVENT_GAP_MAX)
            end

            local aDes = SPEED_KP * (vt - v) + slopeV * v * speedMod

            local coast = COAST_BASE + COAST_QUAD * v * v
            local vmax  = math.max(cruise * VMAX_MUL, 250)
            local aEng  = ACCEL_MAX * math.max(0.05, 1 - (v / vmax) ^ 2)

            local g = gearOf(v)
            if g > lastGear and T > 0.3 then
                shiftEnd = now + rnd(SHIFT_CUT_MIN, SHIFT_CUT_MAX)
            end
            lastGear = g
            local shiftF = (now < shiftEnd) and SHIFT_CUT_FACTOR or 1

            local Td, Bd = 0, 0
            if now - launchT0 >= reaction then
                if aDes >= -coast then
                    Td = math.clamp((aDes + coast) / aEng, 0, 1)
                else
                    Bd = math.clamp((-aDes - coast) / BRAKE_MAX, 0, 1)
                end
            end
            if evBrake > 0 then Td = 0; Bd = math.max(Bd, evBrake) end

            T = T + math.clamp(Td - T, -THR_DN * dt, THR_UP * dt)
            B = B + math.clamp(Bd - B, -BRK_DN * dt, BRK_UP * dt)

            local aT = T * aEng * shiftF - coast - B * BRAKE_MAX
            local lim
            if aT > aLong then
                lim = (aLong >= 0) and JERK_UP or JERK_DOWN
            else
                lim = (aLong <= 0) and JERK_BRAKE or JERK_DOWN
            end
            aLong = aLong + math.clamp(aT - aLong, -lim * dt, lim * dt)
            v = v + aLong * dt
            if v < 0 then v = 0; if aLong < 0 then aLong = 0 end end
            if v > MAX_SAFE_SPEED then v = MAX_SAFE_SPEED end

            if now - launchT0 > 1.5 then
                local rv = root.AssemblyLinearVelocity
                local vReal = rv.X * vdir.X + rv.Z * vdir.Z
                if v - vReal > SYNC_DEAD then
                    v = v - (v - vReal - SYNC_DEAD) * math.clamp(SYNC_RATE * dt, 0, 1)
                end
            end
        end

        if v > maxV then maxV = v end

        if hmag and hmag > 3 then
            slopeF = slopeF + ((aheadP.Y - pAt.Y) / hmag - slopeF) * math.clamp(dt / 0.25, 0, 1)
        end
        local bodyDir = bodyDirOf(vdir, slopeF)
        if Y_FORCE_FULL then
            lv.VectorVelocity = bodyDir * v
        else
            lv.VectorVelocity = vdir * v
        end

        local rollT = LEAN_FACTOR * math.atan(v * wS / 196.2)
        rollT = math.clamp(rollT, -math.rad(LEAN_MAX_DEG), math.rad(LEAN_MAX_DEG))
        rollF = rollF + (rollT - rollF) * math.clamp(dt / 0.12, 0, 1)
        local pitchA = math.clamp(aLong * PITCH_PER_ACCEL, -PITCH_MAX_DEG, PITCH_MAX_DEG)
        local yawN = var.yawNoiseAmp * (math.sin(now * 2.3 + ph1) * 0.6 + math.sin(now * 5.1 + ph2) * 0.4)
        ao.CFrame = poseDir(bodyDir, rollF, math.rad(pitchA)) * CFrame.Angles(0, math.rad(yawN), 0)

        driveKeys(now)

        if now >= uiNext then
            uiNext = now + 0.1
            pcall(function()
                if lbProg then lbProg.Text  = string.format("Tien do: %d%%%s", math.floor(d / TOTAL * 100), released and " (phanh)" or "") end
                if lbTime then lbTime.Text  = string.format("Thoi gian: %.1fs", now - t0) end
                if lbSpeed then lbSpeed.Text = string.format("Toc do: %d | Ga %d%% Phanh %d%%",
                    math.floor(v + 0.5), math.floor(T * 100 + 0.5), math.floor(B * 100 + 0.5)) end
                if lbYaw then lbYaw.Text   = string.format("Lech: %.1f | Lan: %+.1f", distToPath, lat) end
            end)
        end
    end

    if not released then
        smoothStop(lv, root, STOP_TIME_STOP)
    end
    cleanupRace(lv, ao, att)
    return false
end

