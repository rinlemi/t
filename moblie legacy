local pts, cum = {}, {0}
if type(PATH) == "table" and #PATH > 1 then
    for i, p in ipairs(PATH) do pts[i] = Vector3.new(p[1], p[2], p[3]) end
    for i = 2, #pts do cum[i] = cum[i-1] + (pts[i] - pts[i-1]).Magnitude end
end
local TOTAL = cum[#pts] or 0

local REC_DT
do
    local avg = PATH_SRC and tonumber(PATH_SRC:match("trung binh%s+([%d%.]+)%s+stud/s"))
    if avg and avg > 10 and #pts > 2 and TOTAL > 0 then
        REC_DT = TOTAL / avg / (#pts - 1)
    end
end

local function at(d)
    d = math.clamp(d, 0, TOTAL)
    local lo, hi = 1, #pts
    while hi - lo > 1 do
        local mid = (lo + hi) // 2
        if cum[mid] <= d then lo = mid else hi = mid end
    end
    local seg = cum[hi] - cum[lo]
    local a = seg > 0 and (d - cum[lo]) / seg or 0
    return pts[lo]:Lerp(pts[hi], a)
end

local function projectD(realPos, dHint)
    local rx, rz = realPos.X, realPos.Z
    local lo = math.max(0, dHint - PROJECT_WINDOW)
    local hi = math.min(TOTAL, dHint + PROJECT_WINDOW)
    if hi <= lo then return dHint, math.huge end
    local step = (hi - lo) / 40
    local bestD, bestSq = dHint, math.huge
    local dd = lo
    while dd <= hi do
        local p = at(dd)
        local dx, dz = p.X - rx, p.Z - rz
        local s = dx*dx + dz*dz
        if s < bestSq then bestSq = s; bestD = dd end
        dd = dd + step
    end
    local rlo = math.max(lo, bestD - step)
    local rhi = math.min(hi, bestD + step)
    local fine = step / 8
    dd = rlo
    while dd <= rhi do
        local p = at(dd)
        local dx, dz = p.X - rx, p.Z - rz
        local s = dx*dx + dz*dz
        if s < bestSq then bestSq = s; bestD = dd end
        dd = dd + fine
    end
    return bestD, math.sqrt(bestSq)
end

local function nearestD(realPos)
    local rx, rz = realPos.X, realPos.Z
    local bestI, bestSq = 1, math.huge
    for i, p in ipairs(pts) do
        local dx, dz = p.X - rx, p.Z - rz
        local s = dx*dx + dz*dz
        if s < bestSq then bestSq = s; bestI = i end
    end
    return projectD(realPos, cum[bestI])
end

local function flatDir(a, b, fallback)
    local x, z = b.X - a.X, b.Z - a.Z
    local m = math.sqrt(x*x + z*z)
    if m > 0.01 then return Vector3.new(x / m, 0, z / m), m end
    return fallback, m
end

local function rotY(vec, a)
    local c, s = math.cos(a), math.sin(a)
    return Vector3.new(vec.X * c + vec.Z * s, 0, -vec.X * s + vec.Z * c)
end

local function smoothArray(src, half)
    local n = #src
    local pre = {0}
    for i = 1, n do pre[i + 1] = pre[i] + src[i] end
    local out = {}
    for i = 1, n do
        local a, b = math.max(1, i - half), math.min(n, i + half)
        out[i] = (pre[b + 1] - pre[a]) / (b - a + 1)
    end
    return out
end

local DS = PROFILE_DS
local G = 0
local gKL, gAbsK, gHumM, gRace = {}, {}, {}, {}
local minRadius = math.huge

local function buildGrid()
    if #pts < 2 or TOTAL <= DS * 4 then return end
    G = math.floor(TOTAL / DS) + 1
    local pos = {}
    for i = 1, G do pos[i] = at((i - 1) * DS) end

    local W = CURV_HALF_WIN
    for i = 1, G do
        gKL[i] = 0
        local a, b = i - W, i + W
        if a >= 1 and b <= G then
            local t1 = flatDir(pos[a], pos[i], nil)
            local t2 = flatDir(pos[i], pos[b], nil)
            if t1 and t2 then
                local cr  = t1.Z * t2.X - t1.X * t2.Z
                local dot = t1.X * t2.X + t1.Z * t2.Z
                gKL[i] = 2 * math.atan2(cr, dot) / ((b - a) * DS)
            end
        end
        gAbsK[i] = math.abs(gKL[i])
        if gAbsK[i] > 1e-5 then minRadius = math.min(minRadius, 1 / gAbsK[i]) end
    end

    if REC_DT and USE_RECORDED_PROFILE then
        local cc = {0}
        for i = 2, #pts do cc[i] = cc[i-1] + math.min(cum[i] - cum[i-1], 7.5) end
        local function idxOf(d)
            local lo, hi = 1, #pts
            while hi - lo > 1 do
                local mid = (lo + hi) // 2
                if cum[mid] <= d then lo = mid else hi = mid end
            end
            return lo
        end
        local hum = {}
        for i = 1, G do
            local d = (i - 1) * DS
            local a = idxOf(math.max(0, d - PROFILE_SMOOTH))
            local b = idxOf(math.min(TOTAL, d + PROFILE_SMOOTH))
            if b <= a then b = math.min(a + 1, #pts) end
            hum[i] = (cc[b] - cc[a]) / (math.max(b - a, 1) * REC_DT)
        end
        local sorted = {}
        for i = 1, G do sorted[i] = hum[i] end
        table.sort(sorted)
        local top = math.max(sorted[math.max(1, math.floor(G * 0.95))], 1)
        for i = 1, G do gHumM[i] = math.clamp(hum[i] / top, PROFILE_FLOOR, 1) end
    else
        for i = 1, G do gHumM[i] = 1 end
    end

    local raw = {}
    for i = 1, G do raw[i] = math.clamp(-gKL[i] * RACELINE_K, -1, 1) end
    local sm = smoothArray(raw, 12)
    for i = 1, G do gRace[i] = sm[i] * RACELINE_AMP end
end
pcall(buildGrid)

local function gridAt(arr, d)
    if G < 2 then return 0 end
    local x = math.clamp(d / DS, 0, G - 1.0001)
    local i = math.floor(x)
    local f = x - i
    return arr[i + 1] * (1 - f) + arr[i + 2] * f
end

local function buildLapProfile(cruise, alatMul, decelMul)
    local prof = {}
    local alat = A_LAT_MAX * alatMul
    for i = 1, G do
        local k  = math.max(gAbsK[i], 1e-6)
        local vc = math.sqrt(alat / k)
        local m  = 1 - PROFILE_STRENGTH * (1 - gHumM[i])
        prof[i]  = math.max(40, math.min(cruise * m, vc, MAX_SAFE_SPEED))
    end
    local dec = DECEL_PLAN * decelMul
    for i = G - 1, 1, -1 do
        local lim = math.sqrt(prof[i + 1] * prof[i + 1] + 2 * dec * DS)
        if prof[i] > lim then prof[i] = lim end
    end
    return prof
end

local function P(root, ...)
