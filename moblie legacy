local function smoothStop(lv, root, duration)
    if not (lv and lv.Parent and root and root.Parent) then
        if lv and lv.Parent then lv.VectorVelocity = Vector3.zero end
        return
    end
    local v0  = lv.VectorVelocity
    local mag = v0.Magnitude
    if mag < 5 then
        lv.VectorVelocity = Vector3.zero
        return
    end
    duration = duration or STOP_TIME_FINISH
    local dir = v0.Unit
    local t0  = os.clock()
    while os.clock() - t0 < duration do
        if not lv.Parent or not root.Parent then return end
        local a = 1 - (os.clock() - t0) / duration
        a = math.clamp(a, 0, 1) * math.clamp(a, 0, 1)
        lv.VectorVelocity = dir * (mag * a)
        RS.Heartbeat:Wait()
    end
    if lv.Parent then lv.VectorVelocity = Vector3.zero end
end

